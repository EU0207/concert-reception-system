{
  "name": "concert-reception-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "pnpm typecheck && pnpm check:rules && vite build && node scripts/build-pwa.mjs",
    "check:rules": "node scripts/build-database-rules.mjs --check",
    "preview": "node scripts/serve-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/domain/seats/*.test.mjs tests/domain/assignments/*.test.mjs tests/domain/authorization/*.test.mjs tests/app/*.test.mjs mock/scenarios.test.cjs",
    "test:browser": "playwright test",
    "test:authorization": "node scripts/test-authorization-emulators.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "firebase": "13.2.0"
  }
}
