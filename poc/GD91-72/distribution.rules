    function receptionRow(p,g,id,a) {
      let h = get(/databases/$(database)/documents/publicationShows/$(p)/receptionBuilds/$(g)).data;
      let v = beforeVersion(p);
      let s = beforeAssignment(p);
      let person = s.assignments[id];
