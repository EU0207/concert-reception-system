      return manager(p) && h.expectedVersions == v.values && q.cursor == h.seatIds.size()
        && a == {'generation':h.generation,'revision':v.values.reception,'seatCount':h.seatIds.size(),'sections':h.sections};
    }
    function currentReception(p,g) {
      let h = get(/databases/$(database)/documents/publicationShows/$(p)/receptionHead/current).data;
      return normalRead(p) && h.generation == g && h.revision == beforeVersion(p).values.reception;
