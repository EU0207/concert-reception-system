    function sharedDraft(p,id,a) {
      let v = beforeVersion(p);
      let s = get(/databases/$(database)/documents/publicationShows/$(p)/sessions/$(request.auth.uid)).data;
      return manager(p) && control(p).state != 'closed' && proto(p,a) && uuid(id) && a.operationId == id
        && a.deviceUid == request.auth.uid && a.humanUid == s.humanUid && a.expectedVersions == v.values
        && a.keys().toSet() == ['schemaVersion','environmentId','performanceId','operationId','deviceUid','humanUid','expectedVersions','baseVersions','formatVersion','payload','occurredAt'].toSet()
        && a.baseVersions.keys() == v.values.keys() && validDraftBase(a.baseVersions,v.values) && a.formatVersion == 1 && a.payload is map
        && a.payload.keys().toSet() == ['iv','ciphertext','keyId'].toSet()
        && a.payload.iv is string && a.payload.ciphertext is string && a.payload.keyId is string
