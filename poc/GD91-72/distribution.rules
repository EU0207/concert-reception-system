      let geometry = get(/databases/$(database)/documents/publicationShows/$(p)/receptionBuilds/$(g)/geometry/$(id)).data;
      let hasArrival = person != '' && exists(/databases/$(database)/documents/publicationShows/$(p)/receptionRecords/$(person));
      let arrival = hasArrival ? get(/databases/$(database)/documents/publicationShows/$(p)/receptionRecords/$(person)).data.status : 'notReceived';
      return manager(p) && h.expectedVersions == v.values && s.revision == v.values.assignment && h.seatIds.hasAny([id])
        && arrival in ['notReceived','received','cancelled']
        && a.keys().toSet() == geometry.keys().toSet().union(['seatDisplayName','receptionStatus'].toSet())
        && a.diff(geometry).changedKeys().size() == 0 && a.seatDisplayName == label && a.receptionStatus == arrival
        && geometry.revision == v.values.reception;
    }
    function receptionProgress(p,g,b,a,creating) {
