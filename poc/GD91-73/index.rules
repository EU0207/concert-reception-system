    }
    function sharedSelectionFence(p,id,a) {
      let h = getAfter(/databases/$(database)/documents/publicationShows/$(p)/sharedDraftHead/current).data;
      return a.expectedSharedVersion is int && a.expectedSharedVersion >= 0 && h.operationId == id && h.revision == a.expectedSharedVersion+1;
    }
    function sharedSelection(p,a,creating) {
      let d = getAfter(/databases/$(database)/documents/publicationShows/$(p)/sharedDrafts/$(a.operationId)).data;
      return request.auth != null && !exists(/databases/$(database)/documents/publicationShows/$(p)/sharedDrafts/$(a.operationId))
        && a == {'schemaVersion':1,'environmentId':'FAKE-environment','performanceId':p,'operationId':d.operationId,'revision':d.expectedSharedVersion+1}
        && (creating ? d.expectedSharedVersion == 0 : d.expectedSharedVersion == resource.data.revision);
    }
    match /publicationShows/{p}/sharedDraftHead/current {
      allow create: if sharedSelection(p,request.resource.data,true);
      allow update: if sharedSelection(p,request.resource.data,false);
      allow get: if manager(p);
    }
