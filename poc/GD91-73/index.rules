    function publicIndexFence(p,versions) {
      return getAfter(/databases/$(database)/documents/publicationShows/$(p)/publicIndex/current).data.versions == versions;
    }
    function publicIndexWrite(p,a,creating) {
      let v = afterVersion(p);
      let s = v.seatIds.size() == 0 ? null : afterAssignment(p);
      return request.auth != null && (creating ? !exists(/databases/$(database)/documents/publicationShows/$(p)/versions/current)
        : a.versions.commit == resource.data.versions.commit+1)
        && a == {'schemaVersion':1,'environmentId':'FAKE-environment','performanceId':p,
          'versions':v.values,'sections':v.sections,'seatIds':v.seatIds,'assignments':s == null ? {} : s.assignments}
        && (creating || v.values.source == resource.data.versions.source || publicDisplayFence(p,v));
    }
    function publicDisplayFence(p,v) {
      let e = nextEvent(p,v.operationId);
      let d = get(/databases/$(database)/documents/publicationShows/$(p)/sectionDisplay/$(e.generation)).data;
      return d.generation == v.sections[e.sectionId] && d.sectionId == e.sectionId;
    }
    function publicDisplayWrite(p,g,a) {
      let m = candidate(p,g);
      return manager(p) && control(p).state in ['preparing','operating'] && m.ready == true && m.generation == g
        && a == {'schemaVersion':1,'environmentId':'FAKE-environment','performanceId':p,'sectionId':m.sectionId,
          'generation':g,'rows':m.geometry.rows,'columns':m.geometry.columns,'name':a.name,'stagePosition':a.stagePosition}
        && a.name is string && a.name.matches('.*\\S.*') && a.name.size() <= 100 && a.stagePosition in ['left','top'];
    }
    function publicGeneration(p,section,g) {
      return normalRead(p) && get(/databases/$(database)/documents/publicationShows/$(p)/publicIndex/current).data.sections.get(section,'') == g;
    }
    function publicPerson(p,id) {
      return normalRead(p) && get(/databases/$(database)/documents/publicationShows/$(p)/publicIndex/current).data.assignments.values().hasAny([id]);
    }
    match /publicationShows/{p}/publicIndex/current {
      allow create: if publicIndexWrite(p,request.resource.data,true);
      allow update: if publicIndexWrite(p,request.resource.data,false);
      allow get: if normalRead(p);
    }
    match /publicationShows/{p}/sectionDisplay/{g} {
