rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // GD91-24専用。実在席IDの累積と空の割当表の初回発行を接続する。本番Rulesではない。
    function scope(p,x) { return x.schemaVersion == 1 && x.environmentId == 'FAKE-environment' && x.performanceId == p; }
    function roleValid(p,r) {
      return scope(p,r) && r.active == true && r.revision is int && r.revision > 0
        && r.role in ['owner','deputy','temporary','receptionist']
        && r.startsAt is timestamp && r.endsAt is timestamp && r.startsAt <= request.time && request.time < r.endsAt;
    }
    function providerValid(provider,role) { return role in ['owner','deputy'] ? provider == 'google.com' : provider == 'password'; }
    function sessionShape(p,uid,s) {
      return s.keys().hasAll(['schemaVersion','environmentId','performanceId','deviceUid','humanUid','active','emailVerified','authProvider','roleRevision','revision','issuedAt','expiresAt'])
        && s.keys().hasOnly(['schemaVersion','environmentId','performanceId','deviceUid','humanUid','active','emailVerified','authProvider','roleRevision','revision','issuedAt','expiresAt'])
        && scope(p,s) && s.deviceUid == uid && s.humanUid is string && s.humanUid.size() > 0
        && s.active is bool && s.emailVerified == true && s.authProvider is string && s.roleRevision is int
        && s.revision is int && s.revision > 0 && s.issuedAt is timestamp && s.expiresAt is timestamp
        && s.issuedAt <= request.time && s.issuedAt < s.expiresAt && s.expiresAt <= s.issuedAt + duration.value(12,'h');
    }
    function authorized(p, edit) {
      let d = get(/databases/$(database)/documents/splitSeatShows/$(p)/devices/$(request.auth.uid)).data;
      let s = get(/databases/$(database)/documents/splitSeatShows/$(p)/sessions/$(request.auth.uid)).data;
      let r = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(d.humanUid)).data;
      return request.auth.token.firebase.sign_in_provider == 'anonymous' && d.schemaVersion == 1 && d.environmentId == 'FAKE-environment' && d.performanceId == p && d.deviceUid == request.auth.uid
        && d.active == true && s.schemaVersion == 1 && s.environmentId == 'FAKE-environment' && s.performanceId == p && s.deviceUid == request.auth.uid && s.emailVerified == true && s.active == true && s.humanUid == d.humanUid
        && s.expiresAt > request.time && r.schemaVersion == 1 && r.environmentId == 'FAKE-environment' && r.performanceId == p && r.active == true && r.revision > 0 && r.startsAt <= request.time && request.time < r.endsAt && r.role in ['owner','deputy','temporary','receptionist'] && s.roleRevision == r.revision && providerValid(s.authProvider,r.role)
        && d.preparedRoleRevision == r.revision && (!edit || r.role in ['owner', 'deputy']);
    }
    function issueSession(p,uid,a) {
      let d = get(/databases/$(database)/documents/splitSeatShows/$(p)/devices/$(uid)).data;
      let r = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(request.auth.uid)).data;
      return request.auth.token.email_verified == true && providerValid(request.auth.token.firebase.sign_in_provider,r.role)
        && scope(p,d) && d.active == true && d.deviceUid == uid && d.humanUid == request.auth.uid && d.preparedRoleRevision == r.revision
        && roleValid(p,r) && sessionShape(p,uid,a) && a.active == true && a.humanUid == request.auth.uid
        && a.authProvider == request.auth.token.firebase.sign_in_provider && a.roleRevision == r.revision
        && a.issuedAt == request.time && a.expiresAt > request.time && a.expiresAt <= r.endsAt;
    }
    function revokeSession(p,uid,b,a) {
      return request.auth.token.firebase.sign_in_provider in ['google.com','password'] && b.humanUid == request.auth.uid
        && scope(p,b) && b.deviceUid == uid && a.diff(b).affectedKeys().hasOnly(['active','revision'])
        && a.active == false && a.revision == b.revision + 1;
    }
    function manager(p) { return request.auth != null && authorized(p, true); }
    function active(p) { return request.auth != null && authorized(p, false); }
    function head(p, g) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/head/current).data; }
    function nextHead(p, g) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/head/current).data; }
    function event(p, g, id) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/events/$(id)).data; }
    function control(p) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/control/current).data; }
    function fence(p, b, a, e) {
      return a.revision == b.revision + 1 && a.operationId != b.operationId && a.operationId is string
        && e.deviceUid == request.auth.uid && e.baseRevision == b.revision && e.revision == a.revision
        && e.controlRevision == control(p).revision;
    }
    function uuid(id) { return id is string && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
    function registry(p, g) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/idRegistry/current).data; }
    function nextRegistry(p, g) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/idRegistry/current).data; }
    function currentBase(p,g,a) {
      let b = head(p,a.basePublishedGeneration);
      return a.basePublishedGeneration != g && b.status == 'countReady' && b.sectionId == a.sectionId && a.basePublishedRevision == b.revision;
    }
    function initial(p, g, a) {
      let catalog = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      let selected = nextSelection(p);
      return a.keys().hasAll(["sectionId","sectionName","rows","columns","axis","seatOrder","stagePosition","initialNumbered","rowOffset","columnOffset","rowCounts","columnCounts","nonEmptyCount","sourceRevision","revision","operationId","status","cursor","lastChunk","controlRevision","initializationId","chunkSize","numberCursors","numberSpan","basePublishedGeneration","basePublishedRevision"]) && a.keys().hasOnly(["sectionId","sectionName","rows","columns","axis","seatOrder","stagePosition","initialNumbered","rowOffset","columnOffset","rowCounts","columnCounts","nonEmptyCount","sourceRevision","revision","operationId","status","cursor","lastChunk","controlRevision","initializationId","chunkSize","numberCursors","numberSpan","basePublishedGeneration","basePublishedRevision"])
        && uuid(a.sectionId) && a.sectionName is string && a.sectionName.size() > 0
        && a.rows is int && a.columns is int && a.rows > 0 && a.columns > 0 && a.rows <= 100 && a.columns <= 100
        && a.axis in ['horizontal', 'vertical'] && a.seatOrder in ['forward', 'reverse'] && a.stagePosition in ['top', 'left']
        && a.numberSpan in [2,4] && a.chunkSize in [1, 2, 3, 4, 5] && a.initialNumbered is bool && a.rowOffset == 0 && a.columnOffset == 0
        && a.numberCursors == {} && a.rowCounts == {} && a.columnCounts == {} && a.nonEmptyCount == 0
        && a.status == 'building' && a.cursor == 0 && a.lastChunk == '' && a.sourceRevision == 0 && a.revision == 0 && a.operationId == ''
        && a.initializationId == g && uuid(g) && selected.activeGeneration == g && a.controlRevision == control(p).revision
        && catalog.initializationId == g && catalog.sectionId == a.sectionId && catalog.cursor == 0
        && a.basePublishedGeneration is string && a.basePublishedRevision is int && a.basePublishedGeneration == selected.publishedGeneration
        && (a.basePublishedGeneration == '' ? a.basePublishedRevision == 0 : a.basePublishedRevision > 0 && currentBase(p,g,a));
    }
    function occupied(c, j) { return j < c.cells.size() && c.cells[j].kind != 'unset' ? 1 : 0; }
    function validSlot(c, j) {
      let v = c.cells[j];
      return v.keys().hasOnly(['cellId', 'row', 'column', 'kind', 'seatId', 'numberValue'])
        && v.cellId == c.cellIds[j] && uuid(v.cellId) && v.row == c.row && v.column == c.startColumn + j
        && v.kind in ['unset', 'seat', 'gap', 'space', 'aisle']
        && (v.kind == 'seat' ? uuid(v.seatId) : v.seatId == '')
        && (v.kind in ['seat', 'gap']
          ? v.numberValue is int && v.numberValue > 0 && v.numberValue <= 9007199254740991 && c.numberKeys[j] is string
          : v.numberValue == null && c.numberKeys[j] == '');
    }
    function validChunk(b, c, id) {
      return c.keys().hasAll(['row', 'startColumn', 'cells', 'cellIds', 'numberKeys']) && c.keys().hasOnly(['row', 'startColumn', 'cells', 'cellIds', 'numberKeys'])
        && c.row is int && c.startColumn is int && c.row >= 0 && c.row < b.rows && c.startColumn >= 0 && c.startColumn < b.columns
        && c.row * b.columns + c.startColumn == b.cursor && id == string(c.row) + '-' + string(c.startColumn)
        && c.cells is list && c.cellIds is list && c.cells.size() == (b.columns - c.startColumn < b.chunkSize ? b.columns - c.startColumn : b.chunkSize)
        && c.numberKeys is list && c.numberKeys.size() == c.cells.size()
        && c.cellIds.size() == c.cells.size() && c.cellIds.toSet().size() == c.cells.size()
        && validSlot(c, 0) && (c.cells.size() < 2 || validSlot(c, 1))
        && (c.cells.size() < 3 || validSlot(c, 2)) && (c.cells.size() < 4 || validSlot(c, 3)) && (c.cells.size() < 5 || validSlot(c, 4));
    }
    function marker(a) {
      let e = a.get('emergencyChange', null);
      return e == null || e is map && e.keys().hasOnly(['kind', 'reason']) && e.kind in ['add', 'renumber', 'move']
        && e.reason is string && e.reason.matches('.*\\S.*');
    }
    function validAttribute(c, a, j) {
      let v = a.values[j];
      return c.cells[j].kind == 'seat'
        ? v is map && v.keys().hasOnly(['category', 'usable', 'reservedLabel', 'displayOrder', 'emergencyChange'])
          && v.category in ['general', 'reserved', 'special'] && v.usable is bool && v.get('reservedLabel', '') is string
          && v.get('displayOrder', 0) is int && v.get('displayOrder', 0) >= 0 && marker(v)
        : v == null;
    }
    function createAttributes(p, g, id, a) {
      let h = head(p, g);
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(id)).data;
      return pending(p, g) && h.status == 'building' && h.controlRevision == control(p).revision && c.row * h.columns + c.startColumn == h.cursor
        && a.keys().hasAll(['row', 'startColumn', 'values']) && a.keys().hasOnly(['row', 'startColumn', 'values'])
        && a.row == c.row && a.startColumn == c.startColumn && a.values is list && a.values.size() == c.cells.size()
        && validAttribute(c, a, 0) && (c.cells.size() < 2 || validAttribute(c, a, 1))
        && (c.cells.size() < 3 || validAttribute(c, a, 2)) && (c.cells.size() < 4 || validAttribute(c, a, 3)) && (c.cells.size() < 5 || validAttribute(c, a, 4));
    }
    function columnDelta(b, a, c, j) {
      let key = string(c.startColumn + j);
      return a.columnCounts.get(key, 0) == b.columnCounts.get(key, 0) + occupied(c, j)
        && (j < c.cells.size() || a.columnCounts.keys().hasAny([key]) == b.columnCounts.keys().hasAny([key]));
    }
    function ingest(p, g, b, a) {
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(a.lastChunk)).data;
      let delta = occupied(c, 0) + occupied(c, 1) + occupied(c, 2) + occupied(c, 3) + occupied(c, 4);
      let row = string(c.row);
      let ids = nextRegistry(p, g);
      let proof = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/numberProofs/$(a.lastChunk)).data;
      return ids.cursor == a.cursor && ids.initializationId == b.initializationId && b.status == 'building' && b.cursor < b.rows * b.columns
        && exists(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/attributes/$(a.lastChunk))
        && proof.progress == c.cells.size() && a.numberCursors == proof.numberCursors && c.row * b.columns + c.startColumn == b.cursor
        && a.diff(b).affectedKeys().hasOnly(['cursor', 'lastChunk', 'nonEmptyCount', 'rowCounts', 'columnCounts', 'numberCursors'])
        && a.cursor == b.cursor + c.cells.size() && a.nonEmptyCount == b.nonEmptyCount + delta
        && a.rowCounts.diff(b.rowCounts).affectedKeys().hasOnly([row]) && a.rowCounts.get(row, 0) == b.rowCounts.get(row, 0) + delta
        && a.columnCounts.diff(b.columnCounts).affectedKeys().hasOnly([string(c.startColumn + 0), string(c.startColumn + 1), string(c.startColumn + 2), string(c.startColumn + 3), string(c.startColumn + 4)])
        && columnDelta(b, a, c, 0) && columnDelta(b, a, c, 1) && columnDelta(b, a, c, 2) && columnDelta(b, a, c, 3) && columnDelta(b, a, c, 4);
    }
    function finish(p, g, b, a) {
      let e = event(p, g, a.operationId);
      let n = nextSelection(p);
      let v = nextVersions(p);
      return v.generation == g && v.sectionId == b.sectionId && v.operationId == a.operationId
        && v.values.commit == 1 && v.values.layout == 1 && v.values.source == 1 && b.status == 'building' && b.cursor == b.rows * b.columns && a.status == 'countReady'
        && a.diff(b).affectedKeys().hasOnly(['status', 'sourceRevision', 'revision', 'operationId'])
        && a.sourceRevision == 1 && a.revision == 1 && a.operationId != ''
        && n.publishedGeneration == g && n.activeGeneration == '' && n.operationId == a.operationId
        && e.kind == 'initialCounterProof' && e.deviceUid == request.auth.uid && e.initializationId == b.initializationId
        && e.controlRevision == b.controlRevision;
    }
    function versions(p) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/versions/current).data; }
    function nextVersions(p) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/versions/current).data; }
    function positive(n) { return n is int && n > 0 && n <= 9007199254740991; }
    function versionShape(v) {
      return v.keys().hasAll(['commit','layout','source','assignment','attendee','ticket','control'])
        && v.keys().hasOnly(['commit','layout','source','assignment','attendee','ticket','control'])
        && positive(v.commit) && positive(v.layout) && positive(v.source) && positive(v.assignment)
        && positive(v.attendee) && positive(v.ticket) && positive(v.control);
    }
    function changedVersions(b,a) {
      return a.diff(b).affectedKeys().hasOnly(['values','operationId']) && uuid(a.operationId)
        && versionShape(b.values) && versionShape(a.values)
        && a.values.diff(b.values).affectedKeys().hasOnly(['commit','layout'])
        && a.values.commit == b.values.commit+1 && a.values.layout == b.values.layout+1;
    }
    function validSlide(b, a, e) {
      let row = ((e.dr < 0 ? 0 : b.rows - 1) - b.rowOffset + b.rows) % b.rows;
      let column = ((e.dc < 0 ? 0 : b.columns - 1) - b.columnOffset + b.columns) % b.columns;
      return b.status == 'countReady' && b.initialNumbered && b.nonEmptyCount > 0 && e.dr is int && e.dc is int
        && ((e.dr in [-1, 1] && e.dc == 0) || (e.dc in [-1, 1] && e.dr == 0))
        && a.diff(b).affectedKeys().hasOnly(['revision', 'operationId', 'rowOffset', 'columnOffset'])
        && a.rowOffset == (b.rowOffset + e.dr + b.rows) % b.rows && a.columnOffset == (b.columnOffset + e.dc + b.columns) % b.columns
        && (e.dr != 0 ? b.rowCounts.get(string(row), 0) == 0 : b.columnCounts.get(string(column), 0) == 0);
    }
    function slideHead(p,g,b,a) {
      let v = versions(p);
      let n = nextVersions(p);
      let e = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/events/$(a.operationId)).data;
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/control/current).data;
      return v.schemaVersion == 1 && v.performanceId == p && v.generation == g && v.sectionId == b.sectionId
        && v.values.commit == b.revision && v.values.source == b.sourceRevision && v.values.control == c.revision
        && e.environmentId == v.environmentId && e.performanceId == p && e.generation == g && e.sectionId == b.sectionId
        && e.expectedVersions == v.values && e.deviceUid == request.auth.uid && e.kind == 'slide'
        && e.baseRevision == b.revision && e.revision == a.revision
        && n.operationId == a.operationId && changedVersions(v,n) && validSlide(b,a,e);
    }
    // headの更新へ相互に結び、3件の一部だけを確定させない。認可はhead更新で評価する。
    function updateVersions(p,b,a) {
      let h = head(p,b.generation);
      let n = nextHead(p,b.generation);
      return changedVersions(b,a) && h.revision == b.values.commit && n.revision == a.values.commit
        && n.operationId == a.operationId && n.revision == h.revision+1;
    }
    function updateHead(p, g, b, a) {
      return b.status == 'building' ? pending(p, g) && (a.status == 'aborted' ? abortInitial(p, g, b, a)
          : b.controlRevision == control(p).revision && (a.status == 'building' ? ingest(p, g, b, a) : finish(p, g, b, a)))
        : published(p, g) && slideHead(p, g, b, a);
    }
    function createChunk(p, g, id) {
      let h = head(p, g);
      let catalog = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      return pending(p, g) && h.status == 'building' && h.controlRevision == control(p).revision && catalog.sectionId == h.sectionId && catalog.cursor == lineCount(h)
        && validChunk(h, request.resource.data, id);
    }
    function createEvent(p, g, id, e) {
      let b = head(p, g);
      let a = nextHead(p, g);
      return a.operationId == id && ((e.kind == 'abortInitial' && b.status == 'building' && a.status == 'aborted'
          && e.keys().hasOnly(['kind', 'deviceUid', 'initializationId', 'controlRevision']))
        || (e.kind == 'initialCounterProof' && b.status == 'building' && a.status == 'countReady'
          && e.keys().hasOnly(['kind', 'deviceUid', 'initializationId', 'controlRevision']))
        || (e.kind == 'slide' && b.status == 'countReady' && a.status == 'countReady' && a.revision == b.revision + 1
          && e.deviceUid == request.auth.uid && e.baseRevision == b.revision && e.revision == a.revision
          && e.keys().hasAll(['kind','deviceUid','environmentId','performanceId','generation','sectionId','expectedVersions','baseRevision','revision','dr','dc'])
          && e.keys().hasOnly(['kind','deviceUid','environmentId','performanceId','generation','sectionId','expectedVersions','baseRevision','revision','dr','dc'])));
    }
    // 列IDは通常の列設定追加と同じ要求で予約する。
    function createRegistry(p, g, a) {
      let h = head(p, g);
      let catalog = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      let line = catalog.lines['0'];
      return pending(p,g) && h.controlRevision == control(p).revision && catalog.sectionId == h.sectionId && catalog.cursor == 1 && a.usedNumbers == {} && a.seatIds == {}
        && a.keys().hasAll(['initializationId','cursor','lineCursor','usedIds','usedNumbers','seatIds']) && a.keys().hasOnly(['initializationId','cursor','lineCursor','usedIds','usedNumbers','seatIds'])
        && h.status == 'building' && h.cursor == 0 && a.cursor == 0 && a.lineCursor == 1 && a.initializationId == g
        && line.lineId != h.sectionId && a.usedIds.keys().toSet() == [h.sectionId,line.lineId].toSet() && a.usedIds.values().toSet() == [true].toSet();
    }
    function seatId(c, j) { return j < c.cells.size() ? c.cells[j].seatId : ''; }
    function seat(c, j) { return j < c.cells.size() && c.cells[j].kind == 'seat' ? 1 : 0; }
    function consumed(c, j) { return j < c.cells.size() && c.cells[j].kind in ['seat', 'gap'] ? 1 : 0; }
    function ingestRegistry(p, g, h, b, a) {
      let n = nextHead(p, g);
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(n.lastChunk)).data;
      let cells = c.cellIds.toSet();
      let seats = [seatId(c, 0), seatId(c, 1), seatId(c, 2), seatId(c, 3), seatId(c, 4)].toSet().difference([''].toSet());
      let delta = a.usedIds.diff(b.usedIds);
      let numbers = c.numberKeys.toSet().difference([''].toSet());
      let numberDelta = a.usedNumbers.diff(b.usedNumbers);
      let seatDelta = a.seatIds.diff(b.seatIds);
      return h.status == 'building' && n.status == 'building' && n.cursor == h.cursor + c.cells.size()
        && b.cursor == h.cursor && a.cursor == n.cursor && b.initializationId == h.initializationId
        && a.diff(b).affectedKeys().hasOnly(['cursor', 'usedIds', 'usedNumbers', 'seatIds'])
        && seats.size() == seat(c, 0) + seat(c, 1) + seat(c, 2) + seat(c, 3) + seat(c, 4)
        && seatDelta.addedKeys() == seats && seatDelta.changedKeys().size() == 0 && seatDelta.removedKeys().size() == 0
        && (a.seatIds.size() == 0 || a.seatIds.values().toSet() == [true].toSet())
        && cells.intersection(seats).size() == 0 && delta.addedKeys() == cells.union(seats)
        && delta.changedKeys().size() == 0 && delta.removedKeys().size() == 0
        && numbers.size() == consumed(c, 0) + consumed(c, 1) + consumed(c, 2) + consumed(c, 3) + consumed(c, 4)
        && numberDelta.addedKeys() == numbers && numberDelta.changedKeys().size() == 0 && numberDelta.removedKeys().size() == 0
        && (a.usedNumbers.size() == 0 || a.usedNumbers.values().toSet() == [true].toSet())
        && a.usedIds.values().toSet() == [true].toSet();
    }
    function updateRegistry(p, g, b, a) {
      let h = head(p, g);
      return b.lineCursor < lineCount(h) ? appendLineId(p, g, h, b, a) : ingestRegistry(p, g, h, b, a);
    }
    function lineCount(h) { return h.axis == 'horizontal' ? h.rows : h.columns; }
    function emptyCatalog(p, g, a) {
      let h = nextHead(p, g);
      return a.keys().hasAll(['sectionId','initializationId','cursor','lines','lineIds']) && a.keys().hasOnly(['sectionId','initializationId','cursor','lines','lineIds'])
        && a.sectionId == h.sectionId && a.initializationId == g && h.status == 'building' && h.cursor == 0
        && a.cursor == 0 && a.lines == {} && a.lineIds == [];
    }
    function lineShape(h, line, index) {
      return line.keys().hasAll(['lineId','index','name','prefix','startNumber','nextAutomaticNumber']) && line.keys().hasOnly(['lineId','index','name','prefix','startNumber','nextAutomaticNumber'])
        && uuid(line.lineId) && line.index == index && line.name is string && line.name.matches('.*\\S.*') && line.prefix is string
        && line.startNumber is int && line.startNumber > 0 && line.nextAutomaticNumber is int && line.nextAutomaticNumber <= 9007199254740991
        && line.nextAutomaticNumber >= line.startNumber && line.nextAutomaticNumber - line.startNumber <= (h.axis == 'horizontal' ? h.columns : h.rows);
    }
    function appendCatalog(p, g, b, a) {
      let h = head(p, g);
      let line = a.lines[string(b.cursor)];
      let ids = nextRegistry(p, g);
      return pending(p, g) && h.status == 'building' && h.cursor == 0 && h.controlRevision == control(p).revision && b.cursor < lineCount(h)
        && a.diff(b).affectedKeys().hasOnly(['cursor','lines','lineIds']) && a.cursor == b.cursor + 1 && lineShape(h, line, b.cursor)
        && a.lines.diff(b.lines).addedKeys() == [string(b.cursor)].toSet() && a.lines.diff(b.lines).changedKeys().size() == 0 && a.lines.diff(b.lines).removedKeys().size() == 0
        && a.lineIds == b.lineIds.concat([line.lineId]) && ids.lineCursor == a.cursor && ids.usedIds[line.lineId] == true;
    }
    function appendLineId(p, g, h, b, a) {
      let catalog = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      let line = catalog.lines[string(b.lineCursor)];
      let delta = a.usedIds.diff(b.usedIds);
      return h.status == 'building' && h.cursor == 0 && b.cursor == 0 && a.lineCursor == b.lineCursor + 1 && catalog.cursor == a.lineCursor
        && a.diff(b).affectedKeys().hasOnly(['lineCursor','usedIds']) && delta.addedKeys() == [line.lineId].toSet()
        && delta.changedKeys().size() == 0 && delta.removedKeys().size() == 0 && a.usedIds[line.lineId] == true;
    }
    function slotKey(h,c,j) { return string(h.axis == 'horizontal' ? c.row : c.startColumn + (j < c.cells.size() ? j : 0)); }
    function numberSlot(h, c, a, j, lines, b) {
      let key = slotKey(h,c,j);
      let line = lines[key];
      let delta = h.seatOrder == 'forward' ? 1 : -1;
      let v = c.cells[j];
      let before = h.axis == 'horizontal' && j > b.progress ? a.steps[j-1] : b.numberCursors.get(key, delta == 1 ? line.startNumber : line.nextAutomaticNumber-1);
      let after = before + (v.kind in ['seat','gap'] ? delta : 0);
      let last = h.axis != 'horizontal' || j == a.progress-1;
      let end = h.axis == 'horizontal' ? c.startColumn+c.cells.size() == h.columns : c.row == h.rows-1;
      return a.steps[j] == after
        && (v.kind in ['seat','gap'] ? v.numberValue == before && before >= line.startNumber && before < line.nextAutomaticNumber && c.numberKeys[j] == line.lineId+':'+string(before)
          : v.numberValue == null && c.numberKeys[j] == '')
        && (!last || a.numberCursors[key] == after && (!end || h.axis == 'horizontal' && a.progress != c.cells.size() || after == (delta == 1 ? line.nextAutomaticNumber : line.startNumber-1)));
    }
    function validateNumberPart(p,g,h,c,b,a,lines) {
      return pending(p,g) && h.status == 'building' && h.controlRevision == control(p).revision && c.row*h.columns+c.startColumn == h.cursor
        && a.keys().hasAll(['row','startColumn','numberCursors','steps','progress']) && a.keys().hasOnly(['row','startColumn','numberCursors','steps','progress'])
        && a.row == c.row && a.startColumn == c.startColumn && b.progress < c.cells.size() && a.progress == (b.progress+h.numberSpan < c.cells.size() ? b.progress+h.numberSpan : c.cells.size())
        && a.steps is list && a.steps.size() == a.progress && a.steps == b.steps.concat(a.progress == b.progress+1 ? [a.steps[b.progress]] : a.progress == b.progress+2 ? [a.steps[b.progress],a.steps[b.progress+1]] : a.progress == b.progress+3 ? [a.steps[b.progress],a.steps[b.progress+1],a.steps[b.progress+2]] : [a.steps[b.progress],a.steps[b.progress+1],a.steps[b.progress+2],a.steps[b.progress+3]])
        && a.numberCursors is map && a.numberCursors.diff(b.numberCursors).affectedKeys().hasOnly([slotKey(h,c,b.progress),slotKey(h,c,a.progress-1)])
        && numberSlot(h,c,a,b.progress,lines,b) && (a.progress == b.progress+1 || numberSlot(h,c,a,b.progress+1,lines,b))
        && (a.progress <= b.progress+2 || numberSlot(h,c,a,b.progress+2,lines,b)) && (a.progress <= b.progress+3 || numberSlot(h,c,a,b.progress+3,lines,b));
    }
    function createNumberProof(p,g,id,a) {
      let h = head(p,g);
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(id)).data;
      let catalog = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      return validateNumberPart(p,g,h,c,{'progress':0,'steps':[],'numberCursors':h.numberCursors},a,catalog.lines);
    }
    function updateNumberProof(p,g,id,b,a) {
      let h = head(p,g);
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(id)).data;
      let catalog = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      return validateNumberPart(p,g,h,c,b,a,catalog.lines);
    }
    function selection(p) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/selection/current).data; }
    function nextSelection(p) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/selection/current).data; }
    function pending(p, g) { let s = selection(p); return s.activeGeneration == g; }
    function published(p, g) { return selection(p).publishedGeneration == g; }
    function selectionShape(a) {
      return a.keys().hasAll(['revision', 'activeGeneration', 'publishedGeneration', 'operationId'])
        && a.keys().hasOnly(['revision', 'activeGeneration', 'publishedGeneration', 'operationId'])
        && a.revision is int && a.revision > 0 && a.activeGeneration is string && a.publishedGeneration is string && uuid(a.operationId);
    }
    function initialTarget(p, a) {
      let h = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(a.activeGeneration)/head/current).data;
      return uuid(a.activeGeneration) && a.operationId == a.activeGeneration && h.basePublishedGeneration == a.publishedGeneration
        && h.status == 'building' && h.cursor == 0 && h.initializationId == a.activeGeneration;
    }
    function changeSelection(p, b, a) {
      return selectionShape(a) && a.revision == b.revision + 1 && a.operationId != b.operationId
        && (b.activeGeneration == '' ? a.publishedGeneration == b.publishedGeneration && initialTarget(p, a)
          : completedTarget(p, b, a));
    }
    function completedTarget(p, b, a) {
      let h = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(b.activeGeneration)/head/current).data;
      return a.activeGeneration == '' && h.operationId == a.operationId
        && (a.publishedGeneration == b.publishedGeneration && h.status == 'aborted'
          || b.publishedGeneration == '' && a.publishedGeneration == b.activeGeneration && h.status == 'countReady');
    }
    function abortInitial(p, g, b, a) {
      let e = event(p, g, a.operationId);
      let n = nextSelection(p);
      return a.status == 'aborted' && a.diff(b).affectedKeys().hasOnly(['status', 'revision', 'operationId'])
        && a.revision == b.revision + 1 && uuid(a.operationId) && a.operationId != b.operationId
        && n.activeGeneration == '' && n.publishedGeneration == selection(p).publishedGeneration && n.operationId == a.operationId
        && e.kind == 'abortInitial' && e.initializationId == g && e.deviceUid == request.auth.uid && e.controlRevision == control(p).revision;
    }
    function initialAssignment(p,a) {
      let b = head(p,a.generation);
      let h = nextHead(p,a.generation);
      let ids = registry(p,a.generation);
      return a.keys().hasAll(['schemaVersion','environmentId','performanceId','generation','revision','operationId','assignments'])
        && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','generation','revision','operationId','assignments'])
        && scope(p,a) && uuid(a.generation) && uuid(a.operationId) && a.revision == 1 && a.assignments is map
        && b.status == 'building' && b.revision == 0 && b.sourceRevision == 0 && b.cursor == b.rows * b.columns
        && h.status == 'countReady' && h.revision == 1 && h.sourceRevision == 1 && h.operationId == a.operationId
        && ids.initializationId == a.generation && ids.cursor == b.cursor && ids.lineCursor == lineCount(b)
        && a.assignments.keys().toSet() == ids.seatIds.keys().toSet() && a.assignments.values().toSet().hasOnly(['']);
    }
    function initialVersion(p,a) {
      let h = nextHead(p,a.generation);
      let c = control(p);
      let s = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/assignmentState/current).data;
      let person = get(/databases/$(database)/documents/splitSeatShows/$(p)/attendeeState/current).data;
      let ticket = get(/databases/$(database)/documents/splitSeatShows/$(p)/ticketState/current).data;
      return a.keys().hasAll(['schemaVersion','environmentId','performanceId','sectionId','generation','operationId','values'])
        && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','sectionId','generation','operationId','values'])
        && scope(p,a) && a.environmentId == c.environmentId && uuid(a.generation) && uuid(a.sectionId) && a.sectionId == h.sectionId && uuid(a.operationId)
        && h.status == 'countReady' && h.revision == 1 && h.sourceRevision == 1 && h.operationId == a.operationId
        && scope(p,s) && s.generation == a.generation && s.operationId == a.operationId
        && scope(p,person) && positive(person.revision) && scope(p,ticket) && positive(ticket.revision)
        && ticket.issuedSeatIds is list && ticket.issuedSeatIds.size() == 0
        && versionShape(a.values) && a.values.commit == 1 && a.values.layout == 1 && a.values.source == 1
        && a.values.assignment == s.revision && a.values.attendee == person.revision && a.values.ticket == ticket.revision && a.values.control == c.revision;
    }
    function firstPublication(p,b,a) {
      let h = head(p,b.activeGeneration);
      let n = nextHead(p,b.activeGeneration);
      return selectionShape(a) && a.revision == b.revision+1 && a.operationId != b.operationId && b.publishedGeneration == '' && uuid(b.activeGeneration)
        && a.activeGeneration == '' && a.publishedGeneration == b.activeGeneration && a.operationId == n.operationId
        && h.status == 'building' && n.status == 'countReady' && n.revision == h.revision+1;
    }
    match /splitSeatShows/{p} {
      match /sessions/{uid} {
        allow get: if request.auth != null && resource.data.humanUid == request.auth.uid && scope(p,resource.data)
          && request.auth.token.firebase.sign_in_provider in ['google.com','password'];
        allow create: if request.auth != null && request.resource.data.revision == 1 && issueSession(p,uid,request.resource.data);
        allow update: if request.auth != null && (
          revokeSession(p,uid,resource.data,request.resource.data)
          || request.resource.data.revision == resource.data.revision + 1
            && resource.data.humanUid == request.auth.uid && request.resource.data.deviceUid == resource.data.deviceUid
            && issueSession(p,uid,request.resource.data));
      }
      match /assignmentState/current {
        allow get: if manager(p) || active(p) && selection(p).publishedGeneration != '';
        allow create: if request.auth != null && initialAssignment(p,request.resource.data);
      }
      match /versions/current {
        allow get: if active(p) && published(p,resource.data.generation);
        allow create: if request.auth != null && initialVersion(p,request.resource.data);
        allow update: if request.auth != null && updateVersions(p,resource.data,request.resource.data);
      }

      match /{privateCollection}/{id} {
        allow get: if privateCollection in ['devices', 'sessions', 'roles', 'control', 'attendeeState', 'ticketState'] && manager(p);
        allow write: if false;
      }
      match /selection/current {
        allow get: if manager(p) || active(p) && resource.data.publishedGeneration != '';
        allow create: if manager(p) && selectionShape(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.publishedGeneration == '' && initialTarget(p, request.resource.data);
        allow update: if resource.data.publishedGeneration == '' && request.resource.data.publishedGeneration != ''
          ? request.auth != null && firstPublication(p,resource.data,request.resource.data)
          : manager(p) && changeSelection(p, resource.data, request.resource.data);
      }
      match /seatReferences/current { allow get: if active(p) && selection(p).publishedGeneration != ''; }
      match /generations/{g} {
        match /lineCatalog/current {
          allow get: if manager(p) || active(p) && published(p,g) && head(p,g).status == 'countReady';
          allow create: if manager(p) && emptyCatalog(p,g,request.resource.data);
          allow update: if manager(p) && appendCatalog(p,g,resource.data,request.resource.data);
        }
        match /idRegistry/current {
          allow get: if manager(p);
          allow create: if manager(p) && createRegistry(p, g, request.resource.data);
          allow update: if manager(p) && updateRegistry(p, g, resource.data, request.resource.data);
        }
        match /head/current {
          allow get: if manager(p) || active(p) && published(p, g) && resource.data.status == 'countReady';
          allow create: if manager(p) && initial(p, g, request.resource.data);
          allow update: if manager(p) && updateHead(p, g, resource.data, request.resource.data);
        }
        match /chunks/{id} {
          allow get: if manager(p) || active(p) && published(p, g) && head(p, g).status == 'countReady';
          allow create: if manager(p) && createChunk(p, g, id);
        }
        match /attributes/{id} {
          allow get: if manager(p) || active(p) && published(p, g) && head(p, g).status == 'countReady';
          allow create: if manager(p) && createAttributes(p, g, id, request.resource.data);
        }
        match /numberProofs/{id} {
          allow get: if manager(p) || active(p) && published(p,g) && head(p,g).status == 'countReady';
          allow create: if manager(p) && createNumberProof(p,g,id,request.resource.data);
          allow update: if manager(p) && updateNumberProof(p,g,id,resource.data,request.resource.data);
        }
        match /events/{id} {
          allow get: if manager(p);
          allow create: if request.resource.data.kind in ['initialCounterProof','slide']
            ? request.auth != null && createEvent(p,g,id,request.resource.data)
            : manager(p) && createEvent(p,g,id,request.resource.data);
        }
      }
    }
  }
}
