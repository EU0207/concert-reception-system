rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 認可依存1件だけの隔離再現。書込みはownerによる架空前提投入のみ。
    match /diagnostic/{scope}/items/{id} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/diagnostic/$(scope)/access/current).data.active == true
        && get(/databases/$(database)/documents/diagnostic/$(scope)/access/current).data.subjectUid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
