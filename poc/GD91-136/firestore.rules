rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function manager(p) {
      let d = get(/databases/$(database)/documents/archiveDevices/$(request.auth.uid)).data;
      let s = get(/databases/$(database)/documents/archiveShows/$(p)/sessions/$(request.auth.uid)).data;
      let r = get(/databases/$(database)/documents/archiveShows/$(p)/roles/$(d.humanUid)).data;
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        && d.active == true && d.deviceUid == request.auth.uid
        && s.active == true && s.deviceUid == request.auth.uid && s.humanUid == d.humanUid
        && s.performanceId == p && s.roleRevision == r.revision && d.preparedRoleRevision == r.revision
        && s.expiresAt > request.time && s.issuedAt <= request.time
        && s.authProvider == 'google.com' && s.emailVerified == true
        && r.active == true && r.role in ['owner', 'deputy']
        && r.startsAt <= request.time && request.time < r.endsAt;
    }
    function recent(p) {
      return manager(p) && request.time <= get(/databases/$(database)/documents/archiveShows/$(p)/sessions/$(request.auth.uid)).data.humanAuthTime + duration.value(15, 'm');
    }
    function humanManager(p) {
      let r = get(/databases/$(database)/documents/archiveShows/$(p)/roles/$(request.auth.uid)).data;
      return request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email_verified == true
        && r.active == true && r.role in ['owner', 'deputy'] && r.startsAt <= request.time && request.time < r.endsAt
        && request.time <= timestamp.value(request.auth.token.auth_time * 1000) + duration.value(15, 'm');
    }
    match /archiveDevices/{uid} {
      allow get: if request.auth.uid == uid;
      allow update: if request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true && resource.data.humanUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revision'])
        && request.resource.data.active == false && request.resource.data.revision == resource.data.revision + 1;
    }
    match /archiveShows/{p}/roles/{uid} {
      allow get: if request.auth.uid == uid;
      allow update: if humanManager(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/roles/$(request.auth.uid)).data.role == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revision'])
        && request.resource.data.active == false && request.resource.data.revision == resource.data.revision + 1;
    }
    match /archiveShows/{p}/sessions/{uid} {
      allow get: if request.auth.uid == uid;
      allow create, update: if humanManager(p)
        && get(/databases/$(database)/documents/archiveDevices/$(uid)).data.active == true
        && get(/databases/$(database)/documents/archiveDevices/$(uid)).data.humanUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['performanceId','deviceUid','humanUid','active','roleRevision','authProvider','emailVerified','issuedAt','expiresAt','humanAuthTime'])
        && request.resource.data.performanceId == p && request.resource.data.deviceUid == uid
        && request.resource.data.humanUid == request.auth.uid && request.resource.data.active == true
        && request.resource.data.authProvider == 'google.com' && request.resource.data.emailVerified == true
        && request.resource.data.roleRevision == get(/databases/$(database)/documents/archiveShows/$(p)/roles/$(request.auth.uid)).data.revision
        && request.resource.data.roleRevision == get(/databases/$(database)/documents/archiveDevices/$(uid)).data.preparedRoleRevision
        && request.resource.data.issuedAt == request.time
        && request.resource.data.humanAuthTime == timestamp.value(request.auth.token.auth_time * 1000)
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(12, 'h')
        && request.resource.data.expiresAt <= get(/databases/$(database)/documents/archiveShows/$(p)/roles/$(request.auth.uid)).data.endsAt;
    }
    match /archiveShows/{p}/state/current {
      allow get: if request.auth != null && manager(p);
      allow create: if recent(p) && request.resource.data.keys().hasOnly(['phase','nextIndex','total','sourceRevision','sourceHash','lastId'])
        && request.resource.data.phase == 'copying' && request.resource.data.nextIndex == 0
        && request.resource.data.total is int && request.resource.data.total > 0
        && request.resource.data.sourceRevision is int && request.resource.data.sourceRevision > 0
        && request.resource.data.sourceHash is string && request.resource.data.sourceHash.size() == 64
        && request.resource.data.lastId == '';
      allow update: if recent(p)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','nextIndex','lastId'])
        && resource.data.phase == 'copying'
        && ((request.resource.data.phase == 'copying'
          && request.resource.data.nextIndex == resource.data.nextIndex + 1 && request.resource.data.nextIndex <= resource.data.total
          && getAfter(/databases/$(database)/documents/archiveShows/$(p)/records/$(request.resource.data.lastId)).data.index == resource.data.nextIndex)
          || (request.resource.data.phase == 'archived' && request.resource.data.nextIndex == resource.data.nextIndex
            && resource.data.nextIndex == resource.data.total && request.resource.data.lastId == resource.data.lastId));
    }
    match /archiveShows/{p}/records/{id} {
      allow get: if request.auth != null && manager(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase in ['copying', 'archived'];
      allow list: if request.auth != null && manager(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'archived';
      allow create: if recent(p)
        && request.resource.data.keys().hasOnly(['index','personId','name','arrived','revision','lastOp'])
        && request.resource.data.index is int && request.resource.data.index >= 0
        && request.resource.data.personId == id && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.arrived is bool && request.resource.data.revision == 1 && request.resource.data.lastOp == ''
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'copying'
        && request.resource.data.index == get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.nextIndex
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.nextIndex == request.resource.data.index + 1
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.lastId == id;
      allow update: if recent(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'archived'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrived','revision','lastOp'])
        && request.resource.data.arrived is bool && request.resource.data.revision == resource.data.revision + 1
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/events/$(request.resource.data.lastOp)).data.personId == id
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/events/$(request.resource.data.lastOp)).data.arrived == request.resource.data.arrived
        && !exists(/databases/$(database)/documents/archiveShows/$(p)/events/$(request.resource.data.lastOp));
      allow delete: if recent(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'archived'
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/tombstones/$(id)).data.personId == id
        && !exists(/databases/$(database)/documents/archiveShows/$(p)/tombstones/$(id));
    }
    match /archiveShows/{p}/events/{id} {
      allow get, list: if request.auth != null && manager(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'archived';
      allow create: if recent(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'archived'
        && request.resource.data.keys().hasOnly(['personId','arrived','reason','actor','at'])
        && request.resource.data.personId is string && request.resource.data.arrived is bool
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
        && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/records/$(request.resource.data.personId)).data.lastOp == id
        && getAfter(/databases/$(database)/documents/archiveShows/$(p)/records/$(request.resource.data.personId)).data.arrived == request.resource.data.arrived;
      allow delete: if recent(p)
        && exists(/databases/$(database)/documents/archiveShows/$(p)/tombstones/$(resource.data.personId));
    }
    match /archiveShows/{p}/tombstones/{id} {
      allow get: if request.auth != null && manager(p);
      allow create: if recent(p)
        && get(/databases/$(database)/documents/archiveShows/$(p)/state/current).data.phase == 'archived'
        && request.resource.data.keys().hasOnly(['personId','reason','actor','at'])
        && request.resource.data.personId == id && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/archiveShows/$(p)/records/$(id))
        && !existsAfter(/databases/$(database)/documents/archiveShows/$(p)/records/$(id));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
