        let attrsDoc = get(/databases/$(database)/documents/sourceProofShows/$(p)/sections/$(sectionNamespace)/generations/$(h.baseGeneration)/attributes/$(a.chunkId)).data;
        let catalog = get(/databases/$(database)/documents/sourceProofShows/$(p)/sections/$(sectionNamespace)/generations/$(h.baseGeneration)/lineCatalog/current).data;
