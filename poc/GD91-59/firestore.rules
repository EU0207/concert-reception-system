          && a.rows == b.rows && a.columns == b.columns && a.cursor == 0 && a.lastChunk == '' && a.cellIds == [] && a.seatIds == [] && a.seatCells == {}
          && catalog.generation == h.baseGeneration && catalog.sectionId == sectionNamespace && catalog.lines == b.lines
          && a.usedIds is map && a.usedIds.keys().toSet() == catalog.lineIds.concat([sectionNamespace]).toSet() && a.usedIds.values().toSet() == [true].toSet();
