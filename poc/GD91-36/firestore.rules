rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // GD91-36専用の隔離候補。業務形式8を維持し、認可形式2を検証する。
    function scope(p,x) { return x.schemaVersion == 2 && x.environmentId == 'FAKE-environment' && x.performanceId == p; }
    function roleValid(p,r) {
      return scope(p,r) && r.active == true && r.revision is int && r.revision > 0
        && r.role in ['owner','deputy','temporary','receptionist']
        && r.receptionBaselineRevision is int && r.receptionBaselineRevision >= 0 && r.receptionBaselineRevision < r.revision
        && r.startsAt is timestamp && r.endsAt is timestamp && r.startsAt <= request.time && request.time < r.endsAt;
    }
    function providerValid(provider,role) { return role in ['owner','deputy'] ? provider == 'google.com' : provider == 'password'; }
    function currentPreparation(d,s,r) { return d.preparedRoleRevision == r.revision && s.roleRevision == r.revision; }
    function generalPreparation(d,s,r) {
      return r.role == 'temporary' && r.receptionBaselineRevision > 0
        && d.preparedRoleRevision == r.receptionBaselineRevision && s.roleRevision == r.receptionBaselineRevision;
    }
    function sessionShape(p,uid,s) {
      return s.keys().hasAll(['schemaVersion','environmentId','performanceId','deviceUid','humanUid','active','emailVerified','authProvider','roleRevision','revision','issuedAt','expiresAt','humanAuthTime'])
        && s.keys().hasOnly(['schemaVersion','environmentId','performanceId','deviceUid','humanUid','active','emailVerified','authProvider','roleRevision','revision','issuedAt','expiresAt','humanAuthTime'])
        && scope(p,s) && s.deviceUid == uid && s.humanUid is string && s.humanUid.size() > 0
        && s.active is bool && s.emailVerified == true && s.authProvider is string && s.roleRevision is int
        && s.revision is int && s.revision > 0 && s.issuedAt is timestamp && s.expiresAt is timestamp
        && s.humanAuthTime is timestamp && s.humanAuthTime <= s.issuedAt
        && s.issuedAt <= request.time && s.issuedAt < s.expiresAt && s.expiresAt <= s.issuedAt + duration.value(12,'h');
    }
    function recentHumanAt(s,at) { return s.humanAuthTime <= at && at <= s.humanAuthTime + duration.value(15,'m'); }
    function recentHuman(s) { return recentHumanAt(s,request.time); }
    function authorizedLevel(p,level) {
      let d = get(/databases/$(database)/documents/splitSeatShows/$(p)/devices/$(request.auth.uid)).data;
      let s = get(/databases/$(database)/documents/splitSeatShows/$(p)/sessions/$(request.auth.uid)).data;
      let r = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(d.humanUid)).data;
      let managerRole = r.role in ['owner','deputy'];
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        && d.schemaVersion == 2 && d.environmentId == 'FAKE-environment' && d.performanceId == p && d.deviceUid == request.auth.uid && d.active == true
        // 形式と認証時刻の出所はissueSessionが検査し、更新権限もそこで閉じる。
        && s.schemaVersion == 2 && s.environmentId == 'FAKE-environment' && s.performanceId == p && s.deviceUid == request.auth.uid && s.emailVerified == true && s.active == true
        && s.humanUid == d.humanUid && s.expiresAt > request.time
        && r.schemaVersion == 2 && r.environmentId == 'FAKE-environment' && r.performanceId == p && r.active == true && r.revision > 0 && r.startsAt <= request.time && request.time < r.endsAt
        && (managerRole ? s.authProvider == 'google.com' : s.authProvider == 'password')
        && (level == 0 ? (managerRole || r.role in ['temporary','receptionist']) && (currentPreparation(d,s,r) || generalPreparation(d,s,r))
          : currentPreparation(d,s,r) && (level == 3 ? r.role == 'temporary'
            : managerRole && (level == 1 || recentHuman(s))));
    }
    function authorized(p,edit) { return authorizedLevel(p,edit ? 1 : 0); }
    function issueSession(p,uid,a) {
      let d = get(/databases/$(database)/documents/splitSeatShows/$(p)/devices/$(uid)).data;
      let r = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(request.auth.uid)).data;
      return request.auth.token.email_verified == true && providerValid(request.auth.token.firebase.sign_in_provider,r.role)
        && scope(p,d) && d.active == true && d.deviceUid == uid && d.humanUid == request.auth.uid
        && roleValid(p,r) && sessionShape(p,uid,a) && a.active == true && a.humanUid == request.auth.uid
        && (currentPreparation(d,a,r) || generalPreparation(d,a,r))
        && a.authProvider == request.auth.token.firebase.sign_in_provider
        && a.humanAuthTime == timestamp.date(1970,1,1) + duration.value(request.auth.token.auth_time,'s')
        && a.issuedAt == request.time && a.expiresAt > request.time && a.expiresAt <= r.endsAt;
    }
    function revokeSession(p,uid,b,a) {
      return request.auth.token.firebase.sign_in_provider in ['google.com','password'] && b.humanUid == request.auth.uid
        && scope(p,b) && b.deviceUid == uid && a.diff(b).affectedKeys().hasOnly(['active','revision'])
        && a.active == false && a.revision == b.revision + 1;
    }
    function manager(p) { return request.auth != null && authorized(p,true); }
    function active(p) { return request.auth != null && authorized(p,false); }
    function highImpact(p) { return request.auth != null && authorizedLevel(p,2); }
    function transition(b,a) {
      return (b.role == 'receptionist' && a.role == 'temporary' && a.receptionBaselineRevision == b.revision
        || b.role == 'temporary' && a.role == 'receptionist' && a.receptionBaselineRevision == 0)
        && a.revision == b.revision + 1;
    }
    function roleChange(p,uid,b,a) {
      let e = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/authorizationEvents/$(a.operationId)).data;
      return highImpact(p) && roleValid(p,b) && roleValid(p,a) && transition(b,a)
        && a.diff(b).affectedKeys().hasOnly(['role','revision','receptionBaselineRevision','operationId','changedAt'])
        && uuid(a.operationId) && a.changedAt == request.time
        && e.kind == 'roleChange' && e.subjectUid == uid && e.operationId == a.operationId
        && e.deviceUid == request.auth.uid && e.beforeRevision == b.revision && e.afterRevision == a.revision;
    }
    function roleEvent(p,id,e) {
      let b = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(e.subjectUid)).data;
      let a = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(e.subjectUid)).data;
      let s = get(/databases/$(database)/documents/splitSeatShows/$(p)/sessions/$(request.auth.uid)).data;
      return highImpact(p) && e.keys().hasAll(['kind','subjectUid','operationId','deviceUid','humanUid','beforeRevision','afterRevision','occurredAt'])
        && e.keys().hasOnly(['kind','subjectUid','operationId','deviceUid','humanUid','beforeRevision','afterRevision','occurredAt'])
        && e.kind == 'roleChange' && e.operationId == id && uuid(id) && e.deviceUid == request.auth.uid && e.occurredAt == request.time
        && e.humanUid == s.humanUid
        && transition(b,a) && a.operationId == id && a.changedAt == request.time
        && e.beforeRevision == b.revision && e.afterRevision == a.revision;
    }
    function prepareDevice(p,uid,b,a) {
      let r = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(request.auth.uid)).data;
      let e = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/preparationReceipts/$(a.preparationOperationId)).data;
      return request.auth.token.email_verified == true && providerValid(request.auth.token.firebase.sign_in_provider,r.role)
        && roleValid(p,r) && scope(p,b) && b.active == true && b.deviceUid == uid && b.humanUid == request.auth.uid
        && b.preparedRoleRevision != r.revision && a.preparedRoleRevision == r.revision
        && a.diff(b).affectedKeys().hasOnly(['preparedRoleRevision','preparedAt','preparationOperationId'])
        && uuid(a.preparationOperationId) && a.preparedAt == request.time
        && e.deviceUid == uid && e.humanUid == request.auth.uid && e.roleRevision == r.revision && e.operationId == a.preparationOperationId;
    }
    function preparationReceipt(p,id,e) {
      let b = get(/databases/$(database)/documents/splitSeatShows/$(p)/devices/$(e.deviceUid)).data;
      let a = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/devices/$(e.deviceUid)).data;
      let r = get(/databases/$(database)/documents/splitSeatShows/$(p)/roles/$(request.auth.uid)).data;
      return e.keys().hasAll(['operationId','deviceUid','humanUid','roleRevision','occurredAt']) && e.keys().hasOnly(['operationId','deviceUid','humanUid','roleRevision','occurredAt'])
        && request.auth.token.email_verified == true && providerValid(request.auth.token.firebase.sign_in_provider,r.role) && roleValid(p,r)
        && scope(p,b) && b.active == true && b.deviceUid == e.deviceUid && b.humanUid == request.auth.uid
        && e.humanUid == request.auth.uid && e.roleRevision == r.revision && e.operationId == id && uuid(id) && e.occurredAt == request.time
        && b.preparedRoleRevision != r.revision && a.preparedRoleRevision == r.revision && a.preparationOperationId == id && a.preparedAt == request.time;
    }
    function head(p, g) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/head/current).data; }
    function nextHead(p, g) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/head/current).data; }
    function event(p, g, id) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/operations/$(id)).data; }
    function control(p) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/control/current).data; }
    function fence(p, b, a, e) {
      return a.revision == b.revision + 1 && a.operationId != b.operationId && a.operationId is string
        && e.deviceUid == request.auth.uid && e.baseRevision == b.revision && e.revision == a.revision
        && e.controlRevision == control(p).revision;
    }
    function uuid(id) { return id is string && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
    function registry(p, g) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/idRegistry/current).data; }
    function nextRegistry(p, g) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/idRegistry/current).data; }
    function currentBase(p,g,a) {
      let b = head(p,a.basePublishedGeneration);
      return a.basePublishedGeneration != g && b.status == 'countReady' && b.sectionId == a.sectionId && a.basePublishedRevision == b.revision;
    }
    function initial(p, g, a) {
      let catalog = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      let selected = nextSelection(p);
      return a.keys().hasAll(["sectionId","sectionName","rows","columns","axis","seatOrder","stagePosition","initialNumbered","rowOffset","columnOffset","rowCounts","columnCounts","nonEmptyCount","sourceRevision","revision","operationId","status","cursor","lastChunk","controlRevision","initializationId","chunkSize","numberCursors","numberSpan","basePublishedGeneration","basePublishedRevision"]) && a.keys().hasOnly(["sectionId","sectionName","rows","columns","axis","seatOrder","stagePosition","initialNumbered","rowOffset","columnOffset","rowCounts","columnCounts","nonEmptyCount","sourceRevision","revision","operationId","status","cursor","lastChunk","controlRevision","initializationId","chunkSize","numberCursors","numberSpan","basePublishedGeneration","basePublishedRevision"])
        && uuid(a.sectionId) && a.sectionName is string && a.sectionName.size() > 0
        && a.rows is int && a.columns is int && a.rows > 0 && a.columns > 0 && a.rows <= 100 && a.columns <= 100
        && a.axis in ['horizontal', 'vertical'] && a.seatOrder in ['forward', 'reverse'] && a.stagePosition in ['top', 'left']
        && a.numberSpan in [2,4] && a.chunkSize in [1, 2, 3, 4, 5] && a.initialNumbered is bool && a.rowOffset == 0 && a.columnOffset == 0
        && a.numberCursors == {} && a.rowCounts == {} && a.columnCounts == {} && a.nonEmptyCount == 0
        && a.status == 'building' && a.cursor == 0 && a.lastChunk == '' && a.sourceRevision == 0 && a.revision == 0 && a.operationId == ''
        && a.initializationId == g && uuid(g) && selected.activeGeneration == g && a.controlRevision == control(p).revision
        && catalog.initializationId == g && catalog.sectionId == a.sectionId && catalog.cursor == 0
        && a.basePublishedGeneration is string && a.basePublishedRevision is int && a.basePublishedGeneration == selected.publishedGeneration
        && (a.basePublishedGeneration == '' ? a.basePublishedRevision == 0 : a.basePublishedRevision > 0 && currentBase(p,g,a));
    }
    function occupied(c, j) { return j < c.cells.size() && c.cells[j].kind != 'unset' ? 1 : 0; }
    function validSlot(c, j) {
      let v = c.cells[j];
      return v.keys().hasOnly(['cellId', 'row', 'column', 'kind', 'seatId', 'numberValue'])
        && v.cellId == c.cellIds[j] && uuid(v.cellId) && v.row == c.row && v.column == c.startColumn + j
        && v.kind in ['unset', 'seat', 'gap', 'space', 'aisle']
        && (v.kind == 'seat' ? uuid(v.seatId) : v.seatId == '')
        && (v.kind in ['seat', 'gap']
          ? v.numberValue is int && v.numberValue > 0 && v.numberValue <= 9007199254740991 && c.numberKeys[j] is string
          : v.numberValue == null && c.numberKeys[j] == '');
    }
    function validChunk(b, c, id) {
      return c.keys().hasAll(['row', 'startColumn', 'cells', 'cellIds', 'numberKeys']) && c.keys().hasOnly(['row', 'startColumn', 'cells', 'cellIds', 'numberKeys'])
        && c.row is int && c.startColumn is int && c.row >= 0 && c.row < b.rows && c.startColumn >= 0 && c.startColumn < b.columns
        && c.row * b.columns + c.startColumn == b.cursor && id == string(c.row) + '-' + string(c.startColumn)
        && c.cells is list && c.cellIds is list && c.cells.size() == (b.columns - c.startColumn < b.chunkSize ? b.columns - c.startColumn : b.chunkSize)
        && c.numberKeys is list && c.numberKeys.size() == c.cells.size()
        && c.cellIds.size() == c.cells.size() && c.cellIds.toSet().size() == c.cells.size()
        && validSlot(c, 0) && (c.cells.size() < 2 || validSlot(c, 1))
        && (c.cells.size() < 3 || validSlot(c, 2)) && (c.cells.size() < 4 || validSlot(c, 3)) && (c.cells.size() < 5 || validSlot(c, 4));
    }
    function marker(a) {
      let e = a.get('emergencyChange', null);
      return e == null || e is map && e.keys().hasOnly(['kind', 'reason']) && e.kind in ['add', 'renumber', 'move']
        && e.reason is string && e.reason.matches('.*\\S.*');
    }
    function validAttribute(c, a, j) {
      let v = a.values[j];
      return c.cells[j].kind == 'seat'
        ? v is map && v.keys().hasOnly(['category', 'usable', 'reservedLabel', 'displayOrder', 'emergencyChange'])
          && v.category in ['general', 'reserved', 'special'] && v.usable is bool && v.get('reservedLabel', '') is string
          && v.get('displayOrder', 0) is int && v.get('displayOrder', 0) >= 0 && marker(v)
        : v == null;
    }
    function createAttributes(p, g, id, a) {
      let h = head(p, g);
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(id)).data;
      return pending(p, g) && h.status == 'building' && h.controlRevision == control(p).revision && c.row * h.columns + c.startColumn == h.cursor
        && a.keys().hasAll(['row', 'startColumn', 'values']) && a.keys().hasOnly(['row', 'startColumn', 'values'])
        && a.row == c.row && a.startColumn == c.startColumn && a.values is list && a.values.size() == c.cells.size()
        && validAttribute(c, a, 0) && (c.cells.size() < 2 || validAttribute(c, a, 1))
        && (c.cells.size() < 3 || validAttribute(c, a, 2)) && (c.cells.size() < 4 || validAttribute(c, a, 3)) && (c.cells.size() < 5 || validAttribute(c, a, 4));
    }
    function columnDelta(b, a, c, j) {
      let key = string(c.startColumn + j);
      return a.columnCounts.get(key, 0) == b.columnCounts.get(key, 0) + occupied(c, j)
        && (j < c.cells.size() || a.columnCounts.keys().hasAny([key]) == b.columnCounts.keys().hasAny([key]));
    }
    function ingest(p, g, b, a) {
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/chunks/$(a.lastChunk)).data;
      let delta = occupied(c, 0) + occupied(c, 1) + occupied(c, 2) + occupied(c, 3) + occupied(c, 4);
      let row = string(c.row);
      let ids = nextRegistry(p, g);
      let proof = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/numberProofs/$(a.lastChunk)).data;
      return ids.cursor == a.cursor && ids.initializationId == b.initializationId && b.status == 'building' && b.cursor < b.rows * b.columns
        && exists(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/attributes/$(a.lastChunk))
        && proof.progress == c.cells.size() && a.numberCursors == proof.numberCursors && c.row * b.columns + c.startColumn == b.cursor
        && a.diff(b).affectedKeys().hasOnly(['cursor', 'lastChunk', 'nonEmptyCount', 'rowCounts', 'columnCounts', 'numberCursors'])
        && a.cursor == b.cursor + c.cells.size() && a.nonEmptyCount == b.nonEmptyCount + delta
        && a.rowCounts.diff(b.rowCounts).affectedKeys().hasOnly([row]) && a.rowCounts.get(row, 0) == b.rowCounts.get(row, 0) + delta
        && a.columnCounts.diff(b.columnCounts).affectedKeys().hasOnly([string(c.startColumn + 0), string(c.startColumn + 1), string(c.startColumn + 2), string(c.startColumn + 3), string(c.startColumn + 4)])
        && columnDelta(b, a, c, 0) && columnDelta(b, a, c, 1) && columnDelta(b, a, c, 2) && columnDelta(b, a, c, 3) && columnDelta(b, a, c, 4);
    }
    function finish(p, g, b, a) {
      let e = event(p, g, a.operationId);
      let n = nextSelection(p);
      let v = nextVersions(p);
      return v.generation == g && v.sectionId == b.sectionId && v.operationId == a.operationId
        && positive(v.values.commit) && v.values.commit > 1 && v.values.layout == 1 && v.values.source == 1 && b.status == 'building' && b.cursor == b.rows * b.columns && a.status == 'countReady'
        && a.diff(b).affectedKeys().hasOnly(['status', 'sourceRevision', 'revision', 'operationId'])
        && a.sourceRevision == 1 && a.revision == 1 && a.operationId != ''
        && n.publishedGeneration == g && n.activeGeneration == '' && n.operationId == a.operationId
        && e.kind == 'initialCounterProof' && e.deviceUid == request.auth.uid && e.initializationId == b.initializationId
        && e.controlRevision == b.controlRevision;
    }
    function versions(p) { return get(/databases/$(database)/documents/splitSeatShows/$(p)/versions/current).data; }
    function nextVersions(p) { return getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/versions/current).data; }
    function positive(n) { return n is int && n > 0 && n <= 9007199254740991; }
    function versionShape(v) {
      return v.keys().hasAll(['commit','layout','source','assignment','attendee','ticket','control'])
        && v.keys().hasOnly(['commit','layout','source','assignment','attendee','ticket','control'])
        && positive(v.commit) && positive(v.layout) && positive(v.source) && positive(v.assignment)
        && positive(v.attendee) && positive(v.ticket) && positive(v.control);
    }
    function changedVersions(b,a) {
      return a.diff(b).affectedKeys().hasOnly(['values','operationId']) && uuid(a.operationId)
        && versionShape(b.values) && versionShape(a.values)
        && a.values.diff(b.values).affectedKeys().hasOnly(['commit','layout'])
        && a.values.commit == b.values.commit+1 && a.values.layout == b.values.layout+1;
    }
    function validSlide(b, a, e) {
      let row = ((e.dr < 0 ? 0 : b.rows - 1) - b.rowOffset + b.rows) % b.rows;
      let column = ((e.dc < 0 ? 0 : b.columns - 1) - b.columnOffset + b.columns) % b.columns;
      return b.status == 'countReady' && b.initialNumbered && b.nonEmptyCount > 0 && e.dr is int && e.dc is int
        && ((e.dr in [-1, 1] && e.dc == 0) || (e.dc in [-1, 1] && e.dr == 0))
        && a.diff(b).affectedKeys().hasOnly(['revision', 'operationId', 'rowOffset', 'columnOffset'])
        && a.rowOffset == (b.rowOffset + e.dr + b.rows) % b.rows && a.columnOffset == (b.columnOffset + e.dc + b.columns) % b.columns
        && (e.dr != 0 ? b.rowCounts.get(string(row), 0) == 0 : b.columnCounts.get(string(column), 0) == 0);
    }
    function slideHead(p,g,b,a) {
      let v = versions(p);
      let n = nextVersions(p);
      let e = getAfter(/databases/$(database)/documents/splitSeatShows/$(p)/operations/$(a.operationId)).data;
      let c = get(/databases/$(database)/documents/splitSeatShows/$(p)/control/current).data;
      return v.schemaVersion == 8 && v.performanceId == p && v.generation == g && v.sectionId == b.sectionId
        && v.values.layout == b.revision && v.values.source == b.sourceRevision && v.values.control == c.revision
        && e.environmentId == v.environmentId && e.performanceId == p && e.generation == g && e.sectionId == b.sectionId
        && e.expectedVersions == v.values && e.deviceUid == request.auth.uid && e.kind == 'slide'
        && e.baseRevision == b.revision && e.revision == a.revision
        && n.operationId == a.operationId && e.resultVersions == n.values && changedVersions(v,n) && validSlide(b,a,e);
    }
    // headの更新へ相互に結び、3件の一部だけを確定させない。認可はhead更新で評価する。
    function slideVersion(p,b,a) {
      let h = head(p,b.generation);
      let n = nextHead(p,b.generation);
      return changedVersions(b,a) && h.revision == b.values.layout && n.revision == a.values.layout
        && n.operationId == a.operationId && n.revision == h.revision+1;
    }
    function updateHead(p, g, b, a) {
      return b.status == 'building' ? pending(p, g) && (a.status == 'aborted' ? abortInitial(p, g, b, a)
          : b.controlRevision == control(p).revision && (a.status == 'building' ? ingest(p, g, b, a) : finish(p, g, b, a)))
        : published(p, g) && slideHead(p, g, b, a);
    }
    function createChunk(p, g, id) {
      let h = head(p, g);
      let catalog = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/lineCatalog/current).data;
      return pending(p, g) && h.status == 'building' && h.controlRevision == control(p).revision && catalog.sectionId == h.sectionId && catalog.cursor == lineCount(h)
        && validChunk(h, request.resource.data, id);
    }
    function structuralEvent(p, g, id, e) {
      let b = head(p, g);
      let a = nextHead(p, g);
      return a.operationId == id && ((e.kind == 'abortInitial' && b.status == 'building' && a.status == 'aborted'
          && e.keys().hasOnly(['kind', 'generation', 'deviceUid', 'initializationId', 'controlRevision']))
        || (e.kind == 'initialCounterProof' && b.status == 'building' && a.status == 'countReady'
          && e.keys().hasOnly(['kind', 'generation', 'deviceUid', 'initializationId', 'controlRevision']))
        || (e.kind == 'slide' && b.status == 'countReady' && a.status == 'countReady' && a.revision == b.revision + 1
          && e.deviceUid == request.auth.uid && e.baseRevision == b.revision && e.revision == a.revision
          && e.keys().hasAll(['kind','deviceUid','environmentId','performanceId','generation','sectionId','expectedVersions','resultVersions','baseRevision','revision','dr','dc'])
          && e.keys().hasOnly(['kind','deviceUid','environmentId','performanceId','generation','sectionId','expectedVersions','resultVersions','baseRevision','revision','dr','dc'])));
    }
    // 列IDは通常の列設定追加と同じ要求で予約する。
    function createRegistry(p, g, a) {
      let h = head(p, g);
