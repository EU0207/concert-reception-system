      return peopleShape(p,a) && a.diff(b).affectedKeys().hasOnly(['revision','operationId','attendeeId','eligibleAttendeeIds','cancelOperationId']) && a.cancelOperationId == a.operationId
        && t.lastKind == 'cancelAttendance' && a.operationId == t.operationId && a.attendeeId == t.attendeeId
        && b.revision == t.expectedVersions.attendee && a.revision == b.revision+1 && a.revision == t.resultVersions.attendee
        && b.eligibleAttendeeIds.hasAny([a.attendeeId]) && a.eligibleAttendeeIds.toSet() == b.eligibleAttendeeIds.toSet().difference([a.attendeeId].toSet());
    }
    function cancelAssignment(p,b,a) {
      let t = nextTicket(p,request.resource.data.cancelledAttendeeId);
      return businessScope(p,a) && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','generation','revision','operationId','assignments','lastKind','cancelledAttendeeId','cancelOperationId']) && a.lastKind == 'cancelAttendance'
        && a.diff(b).affectedKeys().hasOnly(['revision','operationId','assignments','lastKind','cancelledAttendeeId','cancelOperationId'])
        && a.cancelOperationId == a.operationId && t.lastKind == 'cancelAttendance' && t.attendeeId == a.cancelledAttendeeId && a.operationId == t.operationId
        && a.generation == b.generation && b.revision == t.expectedVersions.assignment && a.revision == b.revision+1 && a.revision == t.resultVersions.assignment
        && b.assignments[t.closedSeatId] == t.attendeeId && a.assignments[t.closedSeatId] == ''
        && a.assignments.keys() == b.assignments.keys() && a.assignments.diff(b.assignments).affectedKeys() == [t.closedSeatId].toSet();
    }
    function cancelEvent(p,id,e) {
      let t = nextTicket(p,e.payload.attendeeId);
      let before = get(/databases/$(database)/documents/splitSeatShows/$(p)/tickets/$(e.payload.attendeeId)).data;
      return businessScope(p,e) && uuid(id) && e.operationId == id && e.deviceUid == request.auth.uid && e.kind == 'cancelAttendance'
        && e.keys().hasAll(['schemaVersion','environmentId','performanceId','operationId','kind','deviceUid','generation','expectedVersions','resultVersions','payload'])
        && e.keys().hasOnly(['schemaVersion','environmentId','performanceId','operationId','kind','deviceUid','generation','expectedVersions','resultVersions','payload'])
        && t.lastKind == e.kind && t.operationId == id && t.expectedVersions == e.expectedVersions && t.resultVersions == e.resultVersions
        && e.payload.keys().hasAll(['attendeeId','creating','before','after','oldSeatId','confirmedPrimary','confirmedTicketWarning','stopConfirmed','confirmedControlVersion'])
        && e.payload.keys().hasOnly(['attendeeId','creating','before','after','oldSeatId','confirmedPrimary','confirmedTicketWarning','stopConfirmed','confirmedControlVersion'])
        && e.payload.creating == false && e.payload.before == ticketAudit(before) && e.payload.after == ticketAudit(t)
        && e.payload.oldSeatId == t.closedSeatId && e.payload.confirmedPrimary == true && e.payload.confirmedTicketWarning is bool
        && (!(before.issued || before.everIssued || before.sent || before.sentAt != null || before.activeCredentialId != '') || e.payload.confirmedTicketWarning == true)
        && e.payload.stopConfirmed is bool && (before.activeCredentialId == '' || e.payload.stopConfirmed == true)
        && e.payload.confirmedControlVersion == e.expectedVersions.control
        && (t.closedSeatId == '' || cancelResultAssignment(p,e,t));
    }
    function cancelResultAssignment(p,e,t) {
      let s = nextAssignment(p);
      return s.operationId == e.operationId && s.revision == e.resultVersions.assignment && s.assignments[t.closedSeatId] == '';
    }

    function ticketWrite(p,id,b,a,creating) {
      let n = nextVersions(p);
      let i = nextTicketIndex(p);
      return ticketRecord(p,id,a) && n.operationId == a.operationId && a.resultVersions == n.values
        && a.ticketRevision == n.values.ticket && (creating || a.ticketRevision > b.ticketRevision)
        && i.operationId == a.operationId && i.revision == n.values.ticket && i.attendeeId == id
        && (creating ? a.revision == 1 && a.currentCycle == 1 : a.revision == b.revision+1)
        && (a.lastKind == 'cancelAttendance' ? !creating && cancelTicket(p,id,b,a)
          : a.lastKind == 'qrReissue' ? !creating && !b.cycleClosed && b.activeCredentialId != ''
          && a.activeCredentialId != b.activeCredentialId && a.activeCode != b.activeCode
          && a.previousCredentialId == b.activeCredentialId && a.previousCode == b.activeCode
          && a.credentialVersion == b.credentialVersion+1 && qrLinks(p,a) && revokedLinks(p,a)
          && a.diff(b).affectedKeys().hasOnly(['revision','operationId','lastKind','ticketRevision','expectedVersions','resultVersions','activeCredentialId','activeCode','credentialVersion','previousCredentialId','previousCode'])
          : a.lastKind == 'qrCreate' ? assignedForQr(p,id,n) && a.activeCredentialId != '' && a.credentialVersion == 1
            && a.previousCredentialId == '' && a.previousCode == '' && a.closedSeatId == '' && qrLinks(p,a)
            && (creating || b.cycleClosed ? a.issued == false && a.sent == false && a.issuedAt == null && a.sentAt == null && a.everIssued == false
              && (creating || a.currentCycle == b.currentCycle+1)
              : b.activeCredentialId == '' && a.diff(b).affectedKeys().hasOnly(['revision','operationId','lastKind','ticketRevision','expectedVersions','resultVersions','activeCredentialId','activeCode','credentialVersion']))
          : eligibleForCheck(p,id,n) && (creating || b.cycleClosed
            ? a.activeCredentialId == '' && a.previousCredentialId == '' && a.previousCode == '' && a.closedSeatId == '' && a.credentialVersion == 0 && a.everIssued == a.issued
              && (creating || a.currentCycle == b.currentCycle+1 && assignedForQr(p,id,n))
              && (a.issued && a.issuedAt == request.time && !a.sent && a.sentAt == null || a.sent && a.sentAt == request.time && !a.issued && a.issuedAt == null)
            : checkChanges(b,a)));
    }
    function ticketIndexUpdate(p,b,a) {
      let t = nextTicket(p,a.attendeeId);
      let protected = !t.cycleClosed && (t.issued || t.everIssued || t.activeCredentialId != '');
      let expected = protected ? b.protectedAttendeeIds.toSet().union([a.attendeeId].toSet()) : b.protectedAttendeeIds.toSet().difference([a.attendeeId].toSet());
      return businessScope(p,a) && a.keys().hasAll(['schemaVersion','environmentId','performanceId','revision','operationId','protectedAttendeeIds','attendeeId'])
        && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','revision','operationId','protectedAttendeeIds','attendeeId'])
        && a.diff(b).affectedKeys().hasOnly(['revision','operationId','protectedAttendeeIds','attendeeId'])
        && a.revision == b.revision+1 && a.revision == t.ticketRevision
        && t.operationId == a.operationId && a.attendeeId == t.attendeeId
        && a.protectedAttendeeIds is list && a.protectedAttendeeIds.size() <= 500
        && a.protectedAttendeeIds.size() == a.protectedAttendeeIds.toSet().size() && a.protectedAttendeeIds.toSet() == expected;
    }
    function credentialCreate(p,id,a) {
      let t = nextTicket(p,a.ticketId);
      return qrScope(p,a) && a.keys().hasAll(['schemaVersion','environmentId','performanceId','ticketId','currentCycle','credentialVersion','status','createdOperationId','revokedOperationId'])
        && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','ticketId','currentCycle','credentialVersion','status','createdOperationId','revokedOperationId'])
        && t.activeCredentialId == id && t.currentCycle == a.currentCycle && t.credentialVersion == a.credentialVersion
        && t.lastKind in ['qrCreate','qrReissue'] && t.operationId == a.createdOperationId
        && a.status == 'active' && a.revokedOperationId == '';
    }
    function codeCreate(p,id,a) {
      let t = nextTicket(p,a.ticketId);
      return qrScope(p,a) && a.keys().hasAll(['schemaVersion','environmentId','performanceId','ticketId','credentialId','active','createdOperationId','revokedOperationId'])
        && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','ticketId','credentialId','active','createdOperationId','revokedOperationId'])
        && t.activeCode == id && t.activeCredentialId == a.credentialId && t.lastKind in ['qrCreate','qrReissue']
        && t.operationId == a.createdOperationId && a.active == true && a.revokedOperationId == '';
    }

    match /splitSeatShows/{p} {
      match /control/current { allow update: if request.auth != null && controlWrite(p,resource.data,request.resource.data); }
      match /attendeeState/current {
        allow create: if request.auth != null && bootstrapIndex(p,request.resource.data,true);
        allow update: if request.auth != null && request.resource.data.get('cancelNoTicketOperationId','') == request.resource.data.operationId && noTicketPeople(p,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.get('cancelNoTicketOperationId','') != request.resource.data.operationId && (request.resource.data.eligibleAttendeeIds.size() < resource.data.eligibleAttendeeIds.size() && request.resource.data.operationId != resource.data.operationId
          ? (request.resource.data.get('cancelOperationId','') == request.resource.data.operationId ? cancelPeople(p,resource.data,request.resource.data) : peopleUpdate(p,resource.data,request.resource.data)) : peopleUpdate(p,resource.data,request.resource.data));
      }
      match /ticketState/current {
        allow create: if request.auth != null && bootstrapIndex(p,request.resource.data,false);
        allow update: if request.auth != null && ticketIndexUpdate(p,resource.data,request.resource.data);
      }
      match /tickets/{id} {
        allow get: if manager(p);
        allow create: if request.auth != null && ticketWrite(p,id,null,request.resource.data,true);
        allow update: if request.auth != null && ticketWrite(p,id,resource.data,request.resource.data,false);
      }
      match /credentials/{id} {
        allow get: if active(p) && qrScope(p,resource.data);
        allow create: if request.auth != null && credentialCreate(p,id,request.resource.data);
        allow update: if request.auth != null && credentialRevoke(p,id,resource.data,request.resource.data);
      }
      match /confirmationCodes/{id} {
        allow get: if manager(p);
        allow create: if request.auth != null && codeCreate(p,id,request.resource.data);
        allow update: if request.auth != null && codeRevoke(p,id,resource.data,request.resource.data);
      }
      match /attendees/{id} {
        allow get: if manager(p);
        allow create: if request.auth != null && profileWrite(p,id,null,request.resource.data,true);
        allow update: if request.auth != null && request.resource.data.get('cancelNoTicketOperationId','') == request.resource.data.operationId && noTicketProfile(p,id,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.get('cancelNoTicketOperationId','') != request.resource.data.operationId && (request.resource.data.get('cancelOperationId','') == request.resource.data.operationId
          ? cancelProfile(p,id,resource.data,request.resource.data) : profileWrite(p,id,resource.data,request.resource.data,false));
      }
      match /operations/{id} {
        allow create: if request.auth != null && request.resource.data.kind == 'cancelWithoutTicket' && noTicketEvent(p,id,request.resource.data);
        allow get: if manager(p);
        allow create: if request.auth != null && request.resource.data.kind != 'cancelWithoutTicket' && (request.resource.data.kind in ['initialCounterProof','slide','abortInitial']
          ? createEvent(p,request.resource.data.generation,id,request.resource.data)
          : request.resource.data.kind == 'cancelAttendance' ? cancelEvent(p,id,request.resource.data) : request.resource.data.kind in ['qrCreate','ticketCheck','qrReissue'] ? ticketEvent(p,id,request.resource.data)
          : request.resource.data.kind == 'bootstrapBusiness' ? bootstrapEvent(p,id,request.resource.data) : normalEvent(p,id,request.resource.data));
      }

      match /roles/{uid} {
        allow update: if request.auth != null && roleChange(p,uid,resource.data,request.resource.data);
      }
      match /devices/{uid} {
        allow update: if request.auth != null && prepareDevice(p,uid,resource.data,request.resource.data);
      }
      match /authorizationEvents/{id} {
        allow create: if request.auth != null && roleEvent(p,id,request.resource.data);
        allow get: if manager(p);
      }
      match /preparationReceipts/{id} {
        allow create: if request.auth != null && preparationReceipt(p,id,request.resource.data);
      }
      // 操作別認可の試験専用。実際の受付や臨時管理者の業務書込みではない。
      match /clockProbes/{id} {
        allow create: if manager(p) && request.resource.data.keys().hasAll(['humanAuthTime','clock'])
          && request.resource.data.keys().hasOnly(['humanAuthTime','clock'])
          && request.resource.data.humanAuthTime is timestamp && request.resource.data.clock is timestamp
          && recentHumanAt(request.resource.data,request.resource.data.clock);
      }
      match /authorizationProbes/{id} {
        allow create: if request.resource.data.keys().hasOnly(['level']) && request.resource.data.level in [0,1,2,3]
          && request.auth != null && authorizedLevel(p,request.resource.data.level);
      }
      match /sessions/{uid} {
        allow get: if request.auth != null && resource.data.humanUid == request.auth.uid && scope(p,resource.data)
          && request.auth.token.firebase.sign_in_provider in ['google.com','password'];
        allow create: if request.auth != null && request.resource.data.revision == 1 && issueSession(p,uid,request.resource.data);
        allow update: if request.auth != null && (
          revokeSession(p,uid,resource.data,request.resource.data)
          || request.resource.data.revision == resource.data.revision + 1
            && resource.data.humanUid == request.auth.uid && request.resource.data.deviceUid == resource.data.deviceUid
            && issueSession(p,uid,request.resource.data));
      }
      match /assignmentState/current {
        allow update: if request.auth != null && request.resource.data.lastKind == 'cancelWithoutTicket' && noTicketAssignment(p,resource.data,request.resource.data);
        allow get: if manager(p) || active(p) && selection(p).publishedGeneration != '';
        allow create: if request.auth != null && initialAssignment(p,request.resource.data);
        allow update: if request.auth != null && request.resource.data.lastKind != 'cancelAttendance' && request.resource.data.lastKind != 'cancelWithoutTicket' && assignmentUpdate(p,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.lastKind == 'cancelAttendance' && cancelAssignment(p,resource.data,request.resource.data);
      }
      match /versions/current {
        allow get: if manager(p) || active(p) && resource.data.generation != '' && published(p,resource.data.generation);
        allow create: if request.auth != null && bootstrapVersion(p,request.resource.data);
        allow update: if request.auth != null && (request.resource.data.values.ticket != resource.data.values.ticket
          ? (request.resource.data.values.attendee != resource.data.values.attendee ? cancelVersion(p,resource.data,request.resource.data) : ticketVersion(p,resource.data,request.resource.data))
          : resource.data.values.layout == 0 && request.resource.data.values.layout == 1 ? initialVersion(p,resource.data,request.resource.data) : request.resource.data.values.layout != resource.data.values.layout ? slideVersion(p,resource.data,request.resource.data) : normalVersion(p,resource.data,request.resource.data));
      }

      match /{privateCollection}/{id} {
        allow get: if privateCollection in ['devices', 'sessions', 'roles', 'control', 'attendeeState', 'ticketState'] && manager(p);
        allow write: if false;
      }
      match /selection/current {
        allow get: if manager(p) || active(p) && resource.data.publishedGeneration != '';
        allow create: if manager(p) && selectionShape(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.publishedGeneration == '' && initialTarget(p, request.resource.data);
        allow update: if resource.data.publishedGeneration == '' && request.resource.data.publishedGeneration != ''
          ? request.auth != null && firstPublication(p,resource.data,request.resource.data)
          : manager(p) && changeSelection(p, resource.data, request.resource.data);
      }
      match /seatReferences/current { allow get: if active(p) && selection(p).publishedGeneration != ''; }
      match /generations/{g} {
        match /lineCatalog/current {
          allow get: if manager(p) || active(p) && published(p,g) && head(p,g).status == 'countReady';
          allow create: if manager(p) && emptyCatalog(p,g,request.resource.data);
          allow update: if manager(p) && appendCatalog(p,g,resource.data,request.resource.data);
        }
        match /idRegistry/current {
          allow get: if manager(p);
          allow create: if manager(p) && createRegistry(p, g, request.resource.data);
          allow update: if manager(p) && updateRegistry(p, g, resource.data, request.resource.data);
        }
        match /head/current {
          allow get: if manager(p) || active(p) && published(p, g) && resource.data.status == 'countReady';
          allow create: if manager(p) && initial(p, g, request.resource.data);
          allow update: if manager(p) && updateHead(p, g, resource.data, request.resource.data);
        }
        match /chunks/{id} {
          allow get: if manager(p) || active(p) && published(p, g) && head(p, g).status == 'countReady';
          allow create: if manager(p) && createChunk(p, g, id);
        }
        match /attributes/{id} {
          allow get: if manager(p) || active(p) && published(p, g) && head(p, g).status == 'countReady';
          allow create: if manager(p) && createAttributes(p, g, id, request.resource.data);
        }
        match /numberProofs/{id} {
          allow get: if manager(p) || active(p) && published(p,g) && head(p,g).status == 'countReady';
          allow create: if manager(p) && createNumberProof(p,g,id,request.resource.data);
          allow update: if manager(p) && updateNumberProof(p,g,id,resource.data,request.resource.data);
        }
      }
    }
  }
}
