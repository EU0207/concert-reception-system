            && construction_issueSession(p,uid,request.resource.data));
      }
      match /assignmentState/current {
        allow update: if request.auth != null && request.resource.data.lastKind == 'cancelWithoutTicket' && construction_noTicketAssignment(p,resource.data,request.resource.data);
        allow get: if construction_manager(p) || construction_active(p) && construction_selection(p).publishedGeneration != '';
        allow create: if request.auth != null && construction_initialAssignment(p,request.resource.data);
        allow update: if request.auth != null && request.resource.data.lastKind != 'cancelAttendance' && request.resource.data.lastKind != 'cancelWithoutTicket' && construction_assignmentUpdate(p,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.lastKind == 'cancelAttendance' && construction_cancelAssignment(p,resource.data,request.resource.data);
      }
      match /versions/current {
        allow get: if construction_publicRead(p) && construction_businessScope(p,resource.data) && (resource.data.generation != '' ? construction_published(p,resource.data.generation) : construction_manager(p));
        allow create: if request.auth != null && construction_bootstrapVersion(p,request.resource.data);
        allow update: if request.auth != null && request.resource.data.labelOperationId == request.resource.data.operationId && construction_labelCentral(p,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.labelOperationId != request.resource.data.operationId && (request.resource.data.values.ticket != resource.data.values.ticket
          ? (request.resource.data.values.attendee != resource.data.values.attendee ? construction_cancelVersion(p,resource.data,request.resource.data) : construction_ticketVersion(p,resource.data,request.resource.data))
          : resource.data.values.layout == 0 && request.resource.data.values.layout == 1 ? construction_initialVersion(p,resource.data,request.resource.data) : request.resource.data.values.layout != resource.data.values.layout ? construction_slideVersion(p,resource.data,request.resource.data) : construction_normalVersion(p,resource.data,request.resource.data));
      }

      match /{privateCollection}/{id} {
        allow get: if privateCollection in ['devices', 'sessions', 'roles', 'control', 'attendeeState', 'ticketState'] && construction_manager(p);
        allow write: if false;
      }
      match /selection/current {
        allow get: if construction_manager(p) || construction_active(p) && resource.data.publishedGeneration != '';
        allow create: if construction_manager(p) && construction_selectionShape(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.publishedGeneration == '' && construction_initialTarget(p, request.resource.data);
        allow update: if resource.data.publishedGeneration == '' && request.resource.data.publishedGeneration != ''
          ? request.auth != null && construction_firstPublication(p,resource.data,request.resource.data)
          : construction_manager(p) && construction_changeSelection(p, resource.data, request.resource.data);
      }
      match /seatReferences/current { allow get: if construction_active(p) && construction_selection(p).publishedGeneration != ''; }
      match /generations/{g} {
        match /lineCatalog/current {
          allow get: if construction_manager(p) || construction_active(p) && construction_published(p,g) && construction_head(p,g).status == 'countReady';
          allow create: if construction_manager(p) && construction_emptyCatalog(p,g,request.resource.data);
          allow update: if construction_manager(p) && construction_appendCatalog(p,g,resource.data,request.resource.data);
        }
        match /idRegistry/current {
          allow get: if construction_manager(p);
          allow create: if construction_manager(p) && construction_createRegistry(p, g, request.resource.data);
          allow update: if construction_manager(p) && construction_updateRegistry(p, g, resource.data, request.resource.data);
        }
        match /head/current {
          allow get: if construction_manager(p) || construction_active(p) && construction_published(p, g) && resource.data.status == 'countReady';
          allow create: if construction_manager(p) && construction_initial(p, g, request.resource.data);
          allow update: if construction_manager(p) && (resource.data.status != 'countReady' || !existsAfter(/databases/$(database)/documents/publicationShows/$(p)/candidates/$(g))) && construction_updateHead(p, g, resource.data, request.resource.data);
        }
        match /chunks/{id} {
          allow get: if construction_manager(p) || construction_active(p) && construction_published(p, g) && construction_head(p, g).status == 'countReady';
          allow create: if construction_manager(p) && construction_createChunk(p, g, id);
        }
        match /attributes/{id} {
          allow get: if construction_manager(p) || construction_active(p) && construction_published(p, g) && construction_head(p, g).status == 'countReady';
          allow create: if construction_manager(p) && construction_createAttributes(p, g, id, request.resource.data);
        }
        match /numberProofs/{id} {
          allow get: if construction_manager(p) || construction_active(p) && construction_published(p,g) && construction_head(p,g).status == 'countReady';
          allow create: if construction_manager(p) && construction_createNumberProof(p,g,id,request.resource.data);
          allow update: if construction_manager(p) && construction_updateNumberProof(p,g,id,resource.data,request.resource.data);
        }
      }
    }
    // GD91-44の公開境界だけを確認する隔離候補。
    function scope(p,x) { return x.schemaVersion == 2 && x.environmentId == 'FAKE-environment' && x.performanceId == p; }
    function roleValid(p,r) {
      return scope(p,r) && r.active == true && r.revision is int && r.revision > 0
        && r.role in ['owner','deputy','temporary','receptionist']
        && r.receptionBaselineRevision is int && r.receptionBaselineRevision >= 0 && r.receptionBaselineRevision < r.revision
        && r.startsAt is timestamp && r.endsAt is timestamp && r.startsAt <= request.time && request.time < r.endsAt;
    }
    function providerValid(provider,role) { return role in ['owner','deputy'] ? provider == 'google.com' : provider == 'password'; }
    function currentPreparation(d,s,r) { return d.preparedRoleRevision == r.revision && s.roleRevision == r.revision; }
    function generalPreparation(d,s,r) {
      return r.role == 'temporary' && r.receptionBaselineRevision > 0
        && d.preparedRoleRevision == r.receptionBaselineRevision && s.roleRevision == r.receptionBaselineRevision;
    }
    function sessionShape(p,uid,s) {
      return s.keys().hasAll(['schemaVersion','environmentId','performanceId','deviceUid','humanUid','active','emailVerified','authProvider','roleRevision','revision','issuedAt','expiresAt','humanAuthTime'])
        && s.keys().hasOnly(['schemaVersion','environmentId','performanceId','deviceUid','humanUid','active','emailVerified','authProvider','roleRevision','revision','issuedAt','expiresAt','humanAuthTime'])
        && scope(p,s) && s.deviceUid == uid && s.humanUid is string && s.humanUid.size() > 0
        && s.active is bool && s.emailVerified == true && s.authProvider is string && s.roleRevision is int
        && s.revision is int && s.revision > 0 && s.issuedAt is timestamp && s.expiresAt is timestamp
        && s.humanAuthTime is timestamp && s.humanAuthTime <= s.issuedAt
        && s.issuedAt <= request.time && s.issuedAt < s.expiresAt && s.expiresAt <= s.issuedAt + duration.value(12,'h');
    }
    function recentHumanAt(s,at) { return s.humanAuthTime <= at && at <= s.humanAuthTime + duration.value(15,'m'); }
    function recentHuman(s) { return recentHumanAt(s,request.time); }
    function identity(p,d,s,r) {
      let managerRole = r.role in ['owner','deputy'];
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        && d.schemaVersion == 2 && d.environmentId == 'FAKE-environment' && d.performanceId == p && d.deviceUid == request.auth.uid && d.active == true
        // 形式と認証時刻の出所はissueSessionが検査し、更新権限もそこで閉じる。
        && s.schemaVersion == 2 && s.environmentId == 'FAKE-environment' && s.performanceId == p && s.deviceUid == request.auth.uid && s.emailVerified == true && s.active == true
        && s.humanUid == d.humanUid && s.expiresAt > request.time
        && r.schemaVersion == 2 && r.environmentId == 'FAKE-environment' && r.performanceId == p && r.active == true && r.revision > 0 && r.startsAt <= request.time && request.time < r.endsAt
        && (managerRole ? s.authProvider == 'google.com' : s.authProvider == 'password')
;
    }
    function authorizedLevel(p,level) {
      let d = get(/databases/$(database)/documents/publicationShows/$(p)/devices/$(request.auth.uid)).data;
      let s = get(/databases/$(database)/documents/publicationShows/$(p)/sessions/$(request.auth.uid)).data;
      let r = get(/databases/$(database)/documents/publicationShows/$(p)/roles/$(d.humanUid)).data;
      let managerRole = r.role in ['owner','deputy'];
      return identity(p,d,s,r)
        && (level == 0 ? (managerRole || r.role in ['temporary','receptionist']) && (currentPreparation(d,s,r) || generalPreparation(d,s,r))
          : currentPreparation(d,s,r) && (level == 3 ? r.role == 'temporary'
            : managerRole && (level == 1 || recentHuman(s))));
    }
    function authorized(p,edit) { return authorizedLevel(p,edit ? 1 : 0); }
    function issueSession(p,uid,a) {
      let d = get(/databases/$(database)/documents/publicationShows/$(p)/devices/$(uid)).data;
      let r = get(/databases/$(database)/documents/publicationShows/$(p)/roles/$(request.auth.uid)).data;
      return request.auth.token.email_verified == true && providerValid(request.auth.token.firebase.sign_in_provider,r.role)
        && scope(p,d) && d.active == true && d.deviceUid == uid && d.humanUid == request.auth.uid
        && roleValid(p,r) && sessionShape(p,uid,a) && a.active == true && a.humanUid == request.auth.uid
        && (currentPreparation(d,a,r) || generalPreparation(d,a,r))
        && a.authProvider == request.auth.token.firebase.sign_in_provider
        && a.humanAuthTime == timestamp.date(1970,1,1) + duration.value(request.auth.token.auth_time,'s')
        && a.issuedAt == request.time && a.expiresAt > request.time && a.expiresAt <= r.endsAt;
    }
    function revokeSession(p,uid,b,a) {
      return request.auth.token.firebase.sign_in_provider in ['google.com','password'] && b.humanUid == request.auth.uid
        && scope(p,b) && b.deviceUid == uid && a.diff(b).affectedKeys().hasOnly(['active','revision'])
        && a.active == false && a.revision == b.revision + 1;
    }
    function manager(p) { return request.auth != null && authorized(p,true); }
    // 公開境界だけの形式1。完成候補と業務初期値は試験で前提投入する。
    function uuid(id) { return id is string && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
    function proto(p,x) { return x.schemaVersion == 1 && x.environmentId == 'FAKE-environment' && x.performanceId == p; }
    function beforeVersion(p) { return get(/databases/$(database)/documents/publicationShows/$(p)/versions/current).data; }
    function afterVersion(p) { return getAfter(/databases/$(database)/documents/publicationShows/$(p)/versions/current).data; }
    function beforeAssignment(p) { return get(/databases/$(database)/documents/publicationShows/$(p)/assignmentState/current).data; }
    function afterAssignment(p) { return getAfter(/databases/$(database)/documents/publicationShows/$(p)/assignmentState/current).data; }
    function nextEvent(p,id) { return getAfter(/databases/$(database)/documents/publicationShows/$(p)/operations/$(id)).data; }
    function candidate(p,g) { return get(/databases/$(database)/documents/publicationShows/$(p)/candidates/$(g)).data; }
    function previous(p,m) { return m.baseGeneration == '' ? {'seatIds': [],'entityIds': []} : candidate(p,m.baseGeneration); }
    function protectedSeats(p) { return get(/databases/$(database)/documents/publicationShows/$(p)/ticketProtection/current).data; }
    function eligible(p) { return get(/databases/$(database)/documents/publicationShows/$(p)/eligible/current).data; }
    function control(p) { return get(/databases/$(database)/documents/publicationShows/$(p)/control/current).data; }
    function preparation(p,c) { return proto(p,c) && c.state == 'preparing' && c.revision > 0 && request.time < c.dayStartsAt; }
    function integer(n) { return n is int && n >= 0 && n <= 9007199254740991; }
    function assignmentShape(p,a) {
      return proto(p,a) && a.keys().hasAll(['schemaVersion','environmentId','performanceId','revision','operationId','publicationOperationId','assignments'])
        && a.keys().hasOnly(['schemaVersion','environmentId','performanceId','revision','operationId','publicationOperationId','assignments'])
        && integer(a.revision) && uuid(a.operationId) && uuid(a.publicationOperationId) && a.assignments is map;
    }
    function common(p,b,a,e,c) {
      return preparation(p,c) && a.keys() == b.keys() && a.values.keys() == b.values.keys() && a.values.control == c.revision
        && a.diff(b).affectedKeys().hasOnly(['operationId','values','sections','seatIds','usedIds','usedGenerations'])
        && uuid(a.operationId) && integer(a.values.commit) && integer(a.values.reception)
        && a.values.commit == b.values.commit+1 && a.values.reception == b.values.reception+1 && a.operationId != b.operationId
        && proto(p,e) && e.operationId == a.operationId && e.deviceUid == request.auth.uid && e.controlRevision == c.revision
        && e.expectedVersions == b.values && e.resultVersions == a.values;
    }
    function readyCandidate(p,e,m,old,b,a) {
      return proto(p,m) && m.ready == true && m.generation == e.generation && uuid(m.generation) && uuid(m.sectionId)
        && m.sectionId == e.sectionId && m.baseGeneration == e.baseGeneration
        && m.seatIds is list && m.entityIds is list && m.changedSeatIds is list
        && m.seatIds.size() == m.seatIds.toSet().size() && m.entityIds.size() == m.entityIds.toSet().size()
        && m.entityIds.toSet().hasAll(m.seatIds) && m.entityIds.toSet().hasAll([m.sectionId])
        && (m.baseGeneration == '' ? !b.sections.keys().hasAny([m.sectionId])
          : proto(p,old) && old.ready == true && old.generation == m.baseGeneration && old.sectionId == m.sectionId && b.sections[m.sectionId] == m.baseGeneration)
        && !b.usedGenerations.hasAny([m.generation]) && a.usedGenerations.toSet() == b.usedGenerations.toSet().union([m.generation].toSet())
        && m.entityIds.toSet().intersection(b.usedIds.toSet()).difference(old.entityIds.toSet()).size() == 0
        && a.usedIds.toSet() == b.usedIds.toSet().union(m.entityIds.toSet())
        && a.sections[m.sectionId] == m.generation && a.sections.diff(b.sections).affectedKeys().hasOnly([m.sectionId])
        && a.seatIds.toSet() == b.seatIds.toSet().difference(old.seatIds.toSet()).union(m.seatIds.toSet())
        && m.changedSeatIds.toSet().difference(old.seatIds.toSet()).size() == 0;
    }
    function publicationAssignment(p,b,a,e,m,old,business) {
      let s = business.before;
      let n = business.after;
      let t = business.tickets;
      let removed = old.seatIds.toSet().difference(m.seatIds.toSet());
      let added = m.seatIds.toSet().difference(old.seatIds.toSet());
      let changed = m.changedSeatIds.toSet().union(removed);
      let keyChange = b.sections.size() == 0 || removed.size() > 0 || added.size() > 0;
      return s.revision == b.values.assignment && n.revision == a.values.assignment
        && s.assignments.keys().toSet() == b.seatIds.toSet() && n.assignments.keys().toSet() == a.seatIds.toSet()
        && e.removed.keys().toSet() == removed && e.removed.values().hasOnly(['']) && s.assignments.diff(e.removed).unchangedKeys() == removed
        && e.added.keys().toSet() == added && e.added.values().hasOnly(['']) && n.assignments.diff(e.added).unchangedKeys() == added
        && e.changed.keys().toSet() == changed && e.changed.values().hasOnly(['']) && s.assignments.diff(e.changed).unchangedKeys() == changed
        && n.assignments.diff(s.assignments).changedKeys().size() == 0
        && proto(p,t) && t.revision == b.values.ticket && t.seatIds.toSet().intersection(changed).size() == 0
        && n.publicationOperationId == a.operationId
        && (keyChange ? n.operationId == a.operationId && n.revision == s.revision+1
          : n.assignments == s.assignments && n.operationId == s.operationId && n.revision == s.revision);
    }
    function publication(p,b,a,e) {
      let c = control(p);
      let m = candidate(p,e.generation);
      let old = previous(p,m);
      let n = afterAssignment(p);
      let keyChange = b.sections.size() == 0 || old.seatIds.toSet() != m.seatIds.toSet();
      return common(p,b,a,e,c)
        && a.values.diff(b.values).affectedKeys().hasOnly(['commit','layout','source','assignment','reception'])
        && integer(a.values.layout) && integer(a.values.source) && a.values.layout == b.values.layout+1 && a.values.source == b.values.source+1
        && n.publicationOperationId == a.operationId && n.revision == a.values.assignment
        && (keyChange ? a.values.assignment == b.values.assignment+1 : a.values.assignment == b.values.assignment);
    }
    // 通常業務の再実装ではなく、キー固定を確認する準備期間専用プローブ。
    function assignmentProbe(p,b,a,e) {
      let c = control(p);
      let s = beforeAssignment(p);
      let n = afterAssignment(p);
      let people = eligible(p);
      let t = protectedSeats(p);
      return common(p,b,a,e,c) && b.values.layout > 0 && a.diff(b).affectedKeys().hasOnly(['operationId','values'])
        && a.values.diff(b.values).affectedKeys().hasOnly(['commit','assignment','reception']) && integer(a.values.assignment) && a.values.assignment == b.values.assignment+1
        && s.revision == b.values.assignment && n.revision == a.values.assignment && n.operationId == a.operationId
        && s.assignments.keys().toSet() == b.seatIds.toSet() && n.assignments.keys() == s.assignments.keys()
        && n.assignments.diff(s.assignments).affectedKeys().size() > 0
        && proto(p,people) && people.revision == b.values.attendee && n.assignments.values().removeAll(['']).size() <= 500
        && n.assignments.values().removeAll(['']).toSet().hasOnly(people.attendeeIds)
        && n.assignments.values().removeAll(['']).size() == n.assignments.values().removeAll(['']).toSet().size()
        && proto(p,t) && t.revision == b.values.ticket && t.seatIds.size() == 0;
    }
    function versionUpdate(p,b,a) {
      let e = nextEvent(p,a.operationId);
      return manager(p) && (e.kind == 'publishSection' ? publication(p,b,a,e) : e.kind == 'assignmentProbe' && assignmentProbe(p,b,a,e));
    }
    function assignmentUpdate(p,b,a) {
      let v = beforeVersion(p);
      let n = afterVersion(p);
      let e = nextEvent(p,a.publicationOperationId != b.publicationOperationId ? a.publicationOperationId : a.operationId);
      return assignmentShape(p,a) && a.keys() == b.keys() && n.values.commit == v.values.commit+1
        && a.revision == n.values.assignment
        && (e.kind == 'publishSection' ? a.publicationOperationId == n.operationId && a.publicationOperationId != b.publicationOperationId
          && a.diff(b).affectedKeys().hasOnly(['revision','operationId','publicationOperationId','assignments']) && publicationChild(p,v,n,e,b,a)
          : e.kind == 'assignmentProbe' && a.operationId == n.operationId && a.operationId != b.operationId && a.revision == b.revision+1
            && a.diff(b).affectedKeys().hasOnly(['revision','operationId','assignments']));
    }
    function publicationChild(p,v,n,e,b,a) {
      let m = candidate(p,e.generation);
      let old = previous(p,m);
      let t = protectedSeats(p);
      return publicationAssignment(p,v,n,e,m,old,{'before':b,'after':a,'tickets':t});
    }
    function eventCreate(p,id,e) {
      let b = beforeVersion(p);
      let a = afterVersion(p);
      let s = get(/databases/$(database)/documents/publicationShows/$(p)/sessions/$(request.auth.uid)).data;
      return proto(p,e) && uuid(id) && e.operationId == id && e.deviceUid == request.auth.uid && e.humanUid == s.humanUid
        && e.occurredAt == request.time && e.keys().hasAll(['schemaVersion','environmentId','performanceId','operationId','kind','deviceUid','humanUid','controlRevision','expectedVersions','resultVersions','sectionId','generation','baseGeneration','removed','added','changed','occurredAt'])
        && e.keys().hasOnly(['schemaVersion','environmentId','performanceId','operationId','kind','deviceUid','humanUid','controlRevision','expectedVersions','resultVersions','sectionId','generation','baseGeneration','removed','added','changed','occurredAt'])
        && e.kind in ['publishSection','assignmentProbe'] && e.removed is map && e.added is map && e.changed is map
        && e.expectedVersions == b.values && e.resultVersions == a.values && a.operationId == id && a.values.commit == b.values.commit+1
        && (e.kind == 'publishSection' ? publicationProof(p,b,a,e) : true);
    }
    function publicationProof(p,b,a,e) {
      let m = candidate(p,e.generation);
      let old = previous(p,m);
      return readyCandidate(p,e,m,old,b,a)
        && a.seatIds.size() == a.seatIds.toSet().size() && a.usedIds.size() == a.usedIds.toSet().size() && a.usedGenerations.size() == a.usedGenerations.toSet().size();
    }

    // 初回構成だけを対象に、検査済み台帳から完成候補を発行する。
    function initialCandidate(p,g,m) {
      let h = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/head/current).data;
      let ids = get(/databases/$(database)/documents/splitSeatShows/$(p)/generations/$(g)/idRegistry/current).data;
      let selected = get(/databases/$(database)/documents/splitSeatShows/$(p)/selection/current).data;
      let b = beforeVersion(p);
      let c = control(p);
      return proto(p,m) && preparation(p,c) && h.controlRevision == c.revision
        && m.keys().hasAll(['schemaVersion','environmentId','performanceId','sectionId','generation','baseGeneration','ready','seatIds','entityIds','changedSeatIds'])
        && m.keys().hasOnly(['schemaVersion','environmentId','performanceId','sectionId','generation','baseGeneration','ready','seatIds','entityIds','changedSeatIds'])
        && uuid(g) && h.initializationId == g && h.sectionId == m.sectionId && h.status == 'countReady'
        && h.revision == 1 && h.sourceRevision == 1 && h.basePublishedGeneration == ''
        && selected.publishedGeneration == g && selected.activeGeneration == ''
        && ids.initializationId == g && ids.cursor == h.rows * h.columns && ids.lineCursor == (h.axis == 'horizontal' ? h.rows : h.columns)
        && m.generation == g && m.baseGeneration == '' && m.ready == true && m.changedSeatIds == []
        && m.seatIds is list && m.seatIds.size() == m.seatIds.toSet().size() && m.seatIds.toSet() == ids.seatIds.keys().toSet()
        && m.entityIds is list && m.entityIds.size() == m.entityIds.toSet().size() && m.entityIds.toSet() == ids.usedIds.keys().toSet()
        && b.sections == {} && b.values.layout == 0 && b.values.source == 0;
    }
    match /publicationShows/{p} {
      match /sessions/{uid} {
        allow create: if request.auth != null && issueSession(p,uid,request.resource.data) && request.resource.data.revision == 1;
        allow update: if request.auth != null && revokeSession(p,uid,resource.data,request.resource.data);
        allow get: if manager(p);
      }
      match /versions/current { allow get: if manager(p); allow update: if versionUpdate(p,resource.data,request.resource.data); }
      match /assignmentState/current { allow get: if manager(p); allow update: if assignmentUpdate(p,resource.data,request.resource.data); }
      match /operations/{id} { allow get: if manager(p); allow create: if eventCreate(p,id,request.resource.data); }
      match /candidates/{g} { allow get: if manager(p); allow create: if manager(p) && initialCandidate(p,g,request.resource.data); allow update, delete: if false; }
      match /{document=**} { allow read,write: if false; }
    }
  }
}
