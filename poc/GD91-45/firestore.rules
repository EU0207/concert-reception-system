        allow update: if request.auth != null && request.resource.data.get('labelOperationId','') != request.resource.data.operationId && request.resource.data.get('cancelNoTicketOperationId','') == request.resource.data.operationId && construction_noTicketPeople(p,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.get('labelOperationId','') != request.resource.data.operationId && request.resource.data.get('cancelNoTicketOperationId','') != request.resource.data.operationId && (request.resource.data.eligibleAttendeeIds.size() < resource.data.eligibleAttendeeIds.size() && request.resource.data.operationId != resource.data.operationId
          ? (request.resource.data.get('cancelOperationId','') == request.resource.data.operationId ? construction_cancelPeople(p,resource.data,request.resource.data) : construction_peopleUpdate(p,resource.data,request.resource.data)) : construction_peopleUpdate(p,resource.data,request.resource.data));
      }
      match /ticketState/current {
        allow create: if request.auth != null && construction_bootstrapIndex(p,request.resource.data,false);
        allow update: if request.auth != null && construction_ticketIndexUpdate(p,resource.data,request.resource.data);
      }
      match /tickets/{id} {
        allow get: if construction_manager(p);
        allow create: if request.auth != null && construction_ticketWrite(p,id,null,request.resource.data,true);
        allow update: if request.auth != null && construction_ticketWrite(p,id,resource.data,request.resource.data,false);
      }
      match /credentials/{id} {
        allow get: if construction_active(p) && construction_qrScope(p,resource.data);
        allow create: if request.auth != null && construction_credentialCreate(p,id,request.resource.data);
        allow update: if request.auth != null && construction_credentialRevoke(p,id,resource.data,request.resource.data);
      }
      match /confirmationCodes/{id} {
        allow get: if construction_manager(p);
        allow create: if request.auth != null && construction_codeCreate(p,id,request.resource.data);
        allow update: if request.auth != null && construction_codeRevoke(p,id,resource.data,request.resource.data);
      }
      match /attendees/{id} {
        allow get: if construction_manager(p);
        allow create: if request.auth != null && construction_profileWrite(p,id,null,request.resource.data,true);
        allow update: if request.auth != null && request.resource.data.get('labelOperationId','') != request.resource.data.operationId && request.resource.data.get('cancelNoTicketOperationId','') == request.resource.data.operationId && construction_noTicketProfile(p,id,resource.data,request.resource.data);
        allow update: if request.auth != null && request.resource.data.get('labelOperationId','') != request.resource.data.operationId && request.resource.data.get('cancelNoTicketOperationId','') != request.resource.data.operationId && (request.resource.data.get('cancelOperationId','') == request.resource.data.operationId
          ? construction_cancelProfile(p,id,resource.data,request.resource.data) : construction_profileWrite(p,id,resource.data,request.resource.data,false));
      }
      match /operations/{id} {
        allow create: if request.auth != null && request.resource.data.kind == 'labelChange' && construction_labelOperation(p,id,request.resource.data);
        allow create: if request.auth != null && request.resource.data.kind == 'cancelWithoutTicket' && construction_noTicketEvent(p,id,request.resource.data);
        allow get: if construction_manager(p);
        allow create: if request.auth != null && request.resource.data.kind != 'cancelWithoutTicket' && request.resource.data.kind != 'labelChange' && (request.resource.data.kind in ['initialCounterProof','slide','abortInitial']
