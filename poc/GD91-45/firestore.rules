          : request.resource.data.kind == 'cancelAttendance' ? construction_cancelEvent(p,id,request.resource.data) : request.resource.data.kind in ['qrCreate','ticketCheck','qrReissue'] ? construction_ticketEvent(p,id,request.resource.data)
          : request.resource.data.kind == 'bootstrapBusiness' ? construction_bootstrapEvent(p,id,request.resource.data) : construction_normalEvent(p,id,request.resource.data));
      }

      match /attendeeLabels/{id} {
        allow get: if request.auth != null && construction_labelShape(p,id,resource.data) && construction_labelRead(p,id);
        allow create: if request.auth != null && construction_registrationLabel(p,id,request.resource.data);
        allow update: if request.auth != null && construction_labelWrite(p,id,request.resource.data,false);
      }
      match /dayEvents/{uid}/entries/{id} {
        allow get: if request.auth != null && construction_ownDayRead(p,uid);
        allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 100 && construction_ownDayRead(p,uid);
        allow create: if request.auth != null && construction_ownEvent(p,uid,id,request.resource.data);
      }
      match /dateProbes/{id} { allow create: if construction_manager(p) && request.resource.data.expected == construction_dayAt(construction_control(p),request.resource.data.at); }
      match /roles/{uid} {
        allow update: if request.auth != null && construction_roleChange(p,uid,resource.data,request.resource.data);
      }
      match /devices/{uid} {
        allow update: if request.auth != null && construction_prepareDevice(p,uid,resource.data,request.resource.data);
      }
      match /authorizationEvents/{id} {
        allow create: if request.auth != null && construction_roleEvent(p,id,request.resource.data);
        allow get: if construction_manager(p);
      }
      match /preparationReceipts/{id} {
        allow create: if request.auth != null && construction_preparationReceipt(p,id,request.resource.data);
      }
      // 操作別認可の試験専用。実際の受付や臨時管理者の業務書込みではない。
      match /clockProbes/{id} {
        allow create: if construction_manager(p) && request.resource.data.keys().hasAll(['humanAuthTime','clock'])
          && request.resource.data.keys().hasOnly(['humanAuthTime','clock'])
          && request.resource.data.humanAuthTime is timestamp && request.resource.data.clock is timestamp
